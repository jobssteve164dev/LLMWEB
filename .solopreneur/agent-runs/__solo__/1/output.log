-.connectionInstructions li > span { align-items: center; background: var(--ink); border-radius: 50%; color: white; display: flex; font-size: 11px; height: 26px; justify-content: center; }
-.connectionInstructions strong { display: block; font-size: 13px; margin-bottom: 9px; }
 code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
