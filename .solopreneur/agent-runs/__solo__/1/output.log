    database_url: str = "sqlite:///./.runner/control-plane.db"
    web_token: str = "local-dev-token"
    public_url: str = "http://localhost:8000"
    pairing_ttl_minutes: int = 15
    runner_offline_seconds: int = 45


@lru_cache
def get_settings() -> Settings:
