 .waitingLine { align-items: center; border-top: 1px solid var(--line); color: var(--muted); display: flex; font-size: 12px; gap: 9px; margin: 0; padding: 17px 26px; }
 .pulseDot { animation: pulse 1.4s infinite; background: var(--green); border-radius: 50%; height: 8px; width: 8px; }
 @keyframes pulse { 50% { box-shadow: 0 0 0 6px rgba(33,110,80,.1); opacity: .7; } }
