   473	def update_completed_result(db: Session, job: Job, payload: dict[str, Any]) -> None:
   474	    if job.kind == "inspect" and job.dataset_id:
   475	        dataset = db.get(Dataset, job.dataset_id)
   476	        if dataset:
   477	            dataset.status = "ready"
   478	            dataset.version_hash = payload.get("version_hash")
   479	            dataset.statistics = payload.get("statistics", {})
   480	            dataset.preview = payload.get("preview") if dataset.preview_allowed else None
   481	    if not job.experiment_id:
   482	        return
   483	    experiment = db.get(Experiment, job.experiment_id)
   484	    if experiment is None:
   485	        return
   486	    if job.kind == "baseline":
   487	        experiment.baseline_metrics = payload.get("metrics", {})
   488	        if experiment.evaluation_preview_allowed:
   489	            samples = dict(experiment.evaluation_samples or {})
   490	            samples["baseline"] = payload.get("preview", [])
   491	            experiment.evaluation_samples = samples
   492	    elif job.kind == "evaluate":
   493	        experiment.tuned_metrics = payload.get("metrics", {})
   494	        if experiment.evaluation_preview_allowed:
   495	            samples = dict(experiment.evaluation_samples or {})
   496	            samples["tuned"] = payload.get("preview", [])
   497	            experiment.evaluation_samples = samples
   498	        export_job = db.scalar(select(Job).where(Job.experiment_id == experiment.id, Job.kind == "export"))
   499	        if export_job and export_job.status == "blocked":
   500	            export_job.status = "queued"
   501	        experiment.current_stage = "export"
   502	    elif job.kind == "train":
   503	        checkpoints = payload.get("checkpoints") or [{"reference": "adapter", "label": "最终训练结果", "recommended": True}]
   504	        experiment.checkpoints = checkpoints
   505	        experiment.status = "awaiting_selection"
   506	        experiment.current_stage = "select"
   507	    elif job.kind == "export":
   508	        experiment.artifacts = payload.get("artifacts", [])
   509	        experiment.status = "completed"
   510	        experiment.current_stage = "completed"
   511	
