   290	    def _clean_metric_data(self, metric_data: Dict[str, Any]) -> Dict[str, Any]:
   291	        """清理指标数据，移除不可序列化的对象"""
   292	        cleaned_data = {}
   293	        
   294	        for key, value in metric_data.items():
   295	            if hasattr(value, 'item'):  # PyTorch Tensor
   296	                try:
   297	                    cleaned_data[key] = value.item()
   298	                except:
   299	                    cleaned_data[key] = float(value)
   300	            elif hasattr(value, 'tolist'):  # NumPy array
   301	                try:
   302	                    cleaned_data[key] = value.tolist()
   303	                except:
   304	                    cleaned_data[key] = str(value)
   305	            elif isinstance(value, (int, float, str, bool, type(None))):
   306	                cleaned_data[key] = value
   307	            elif isinstance(value, (list, tuple)):
   308	                cleaned_data[key] = [self._clean_metric_data({'item': v})['item'] if isinstance(v, dict) else v for v in value]
   309	            elif isinstance(value, dict):
   310	                cleaned_data[key] = self._clean_metric_data(value)
   311	            else:
   312	                # 对于其他类型，尝试转换为字符串
   313	                cleaned_data[key] = str(value)
   314	        
   315	        return cleaned_data
