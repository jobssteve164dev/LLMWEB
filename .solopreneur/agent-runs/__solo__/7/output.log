    40	func (worker *Worker) Run(ctx context.Context) error {
    41		log.Printf("算力 %s 已连接，等待网页任务", worker.state.Name)
    42		for {
    43			if err := worker.flush(ctx); err != nil {
    44				log.Printf("状态暂未同步，将自动重试: %v", err)
    45			}
    46			if worker.state.Active == nil {
    47				lease, err := worker.client.Lease(ctx)
    48				if err != nil {
    49					if !wait(ctx, 5*time.Second) {
    50						return nil
    51					}
    52					continue
    53				}
    54				if lease == nil {
    55					_, _ = worker.client.Heartbeat(ctx, worker.report, "")
    56					if !wait(ctx, 5*time.Second) {
    57						return nil
    58					}
    59					continue
    60				}
    61				worker.state.Active = lease
    62				if err := worker.store.Save(worker.state); err != nil {
    63					return err
    64				}
    65			}
    66			if err := worker.executeActive(ctx); err != nil {
    67				return err
    68			}
    69		}
    70	}
    71	
    72	func (worker *Worker) executeActive(ctx context.Context) error {
    73		lease := *worker.state.Active
    74		events := make(chan controlplane.Event, 128)
    75		result := make(chan executionResult, 1)
    76		executionContext, cancel := context.WithCancel(ctx)
    77		defer cancel()
    78		emit := func(eventType, message string, payload map[string]any) {
    79			if payload == nil {
    80				payload = map[string]any{}
    81			}
    82			event := controlplane.Event{
    83				EventID: fmt.Sprintf("%s-%d-%d", lease.JobID, time.Now().UnixNano(), worker.sequence.Add(1)),
    84				Type:    eventType,
    85				Message: message,
    86				Payload: payload,
    87			}
    88			select {
    89			case events <- event:
    90			case <-executionContext.Done():
    91			}
    92		}
    93	
    94		emit("accepted", "任务已保存到本地并开始执行", map[string]any{})
    95		go func() {
    96			payload, err := worker.executor.Run(executionContext, lease, emit)
    97			result <- executionResult{payload: payload, err: err}
    98		}()
    99	
   100		heartbeat := time.NewTicker(10 * time.Second)
   101		defer heartbeat.Stop()
   102		cancelled := false
   103		lastControl := ""
   104		for {
   105			select {
   106			case <-ctx.Done():
   107				return nil
   108			case event := <-events:
   109				worker.queue(lease, []controlplane.Event{event})
   110				_ = worker.flush(ctx)
   111			case outcome := <-result:
   112				for {
   113					select {
   114					case event := <-events:
   115						worker.queue(lease, []controlplane.Event{event})
   116					default:
   117						goto drained
   118					}
   119				}
   120			drained:
   121				var final controlplane.Event
   122				if cancelled {
   123					final = worker.event(lease.JobID, "cancelled", "任务已取消", map[string]any{})
   124				} else if outcome.err != nil {
   125					final = worker.event(lease.JobID, "failed", outcome.err.Error(), map[string]any{})
   126				} else {
   127					final = worker.event(lease.JobID, "completed", "任务已完成", outcome.payload)
   128				}
   129				worker.queue(lease, []controlplane.Event{final})
   130				worker.state.Active = nil
   131				if err := worker.store.Save(worker.state); err != nil {
   132					return err
   133				}
   134				_ = worker.flush(ctx)
   135				return nil
   136			case <-heartbeat.C:
   137				controls, err := worker.client.Heartbeat(ctx, worker.report, lease.JobID)
   138				if err != nil {
   139					continue
   140				}
   141				for _, control := range controls {
   142					if control.JobID != lease.JobID {
   143						continue
   144					}
   145					if control.Action == lastControl {
   146						continue
   147					}
   148					if err := worker.executor.Control(control.Action); err != nil {
   149						emit("log", err.Error(), map[string]any{})
   150						continue
   151					}
   152					lastControl = control.Action
   153					switch control.Action {
   154					case "paused":
   155						emit("paused", "训练已暂停，可随时继续", map[string]any{})
   156					case "running":
   157						emit("progress", "训练已继续", map[string]any{})
   158					case "cancelled":
   159						cancelled = true
   160						cancel()
   161					}
   162				}
   163			}
   164		}
   165	}
   166	
   167	func (worker *Worker) event(jobID, eventType, message string, payload map[string]any) controlplane.Event {
   168		return controlplane.Event{
   169			EventID: fmt.Sprintf("%s-%d-%d", jobID, time.Now().UnixNano(), worker.sequence.Add(1)),
   170			Type:    eventType,
   171			Message: message,
   172			Payload: payload,
   173		}
   174	}
   175	
   176	func (worker *Worker) queue(lease controlplane.Lease, events []controlplane.Event) {
   177		worker.state.PendingEvents = append(worker.state.PendingEvents, localstate.QueuedEvents{
   178			JobID: lease.JobID, LeaseID: lease.LeaseID, Events: events,
   179		})
   180		if err := worker.store.Save(worker.state); err != nil {
   181			log.Printf("保存待同步状态失败: %v", err)
   182		}
   183	}
   184	
   185	func (worker *Worker) flush(ctx context.Context) error {
   186		for len(worker.state.PendingEvents) > 0 {
   187			queued := worker.state.PendingEvents[0]
   188			if err := worker.client.Events(ctx, queued.JobID, queued.LeaseID, queued.Events); err != nil {
   189				return err
   190			}
   410			}
   411		}
   412		return metrics
   413	}
