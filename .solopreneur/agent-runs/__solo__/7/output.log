   270	            self.current_session = IntelligentTrainingSession(
   271	                session_id=session_id,
   272	                start_time=time.time(),
   273	                original_config=initial_config.copy(),
   274	                current_config=initial_config.copy(),
   275	                training_iterations=[],
   276	                total_iterations=0,
   277	                max_iterations=self.config['max_iterations'],
   278	                status='running',
   279	                best_metrics=None,
   280	                best_config=None
   281	            )
   282	            
   283	            self.is_running = True
   284	            self.current_iteration = 0
