   288	            
   289	            # 开始监控
   290	            self._start_monitoring()
   291	            
   292	            self.status_updated.emit(f"智能训练已启动，会话ID: {session_id}")
   293	            self.training_started.emit({
   294	                'session_id': session_id,
   295	                'config': initial_config,
   296	                'timestamp': time.time()
   297	            })
   298	            
   299	            return True
   300	            
   301	        except Exception as e:
   302	            self.error_occurred.emit(f"启动智能训练失败: {str(e)}")
   303	            return False
