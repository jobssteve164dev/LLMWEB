   351	    def _find_latest_metrics_file(self) -> Optional[str]:
   352	        """查找最新的训练指标文件"""
   353	        try:
   354	            import glob
   355	            pattern = os.path.join(self.data_dir, "*_metrics.json")
   356	            files = glob.glob(pattern)
   357	            
   358	            if not files:
   359	                return None
   360	                
   361	            # 按修改时间排序，返回最新的文件
   362	            latest_file = max(files, key=os.path.getmtime)
   363	            return latest_file
   364	            
   365	        except Exception as e:
   366	            print(f"❌ 查找最新数据文件失败: {str(e)}")
   367	            return None
