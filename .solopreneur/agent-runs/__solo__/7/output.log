   693	    def _is_converged(self, metrics: Dict[str, Any]) -> bool:
   694	        """判断是否已收敛"""
   695	        try:
   696	            val_acc = metrics.get('val_accuracy', 0)
   697	            
   698	            # 如果验证准确率很高，认为已收敛
   699	            if val_acc > 0.95:
   700	                return True
   701	            
   702	            # 检查最近几次迭代的改进
   703	            if len(self.current_session.training_iterations) >= 3:
   704	                recent_improvements = []
   705	                for i in range(-3, 0):
   706	                    if i < 0:
   707	                        iteration = self.current_session.training_iterations[i]
   708	                        if 'final_metrics' in iteration:
   709	                            recent_improvements.append(iteration['final_metrics'].get('val_accuracy', 0))
   710	                
   711	                if len(recent_improvements) >= 3:
   712	                    # 计算改进幅度
   713	                    improvement = max(recent_improvements) - min(recent_improvements)
   714	                    if improvement < self.config['convergence_threshold']:
   715	                        return True
   716	            
   717	            return False
   718	            
   719	        except Exception as e:
   720	            self.error_occurred.emit(f"判断收敛状态失败: {str(e)}")
