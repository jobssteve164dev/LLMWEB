   437	class CustomAPIAdapter(LLMAdapter):
   438	    """自定义API适配器 - 支持OpenAI兼容的API"""
   439	    
   440	    def __init__(self, api_key: str, model: str = 'custom-model', base_url: str = None, 
   441	                 provider_type: str = "OpenAI兼容", temperature: float = 0.1,  # 降低温度以确保一致性 
   442	                 max_tokens: int = 1000):
   443	        super().__init__(model)
   444	        self.api_key = api_key
   445	        self.model = model
   446	        self.base_url = base_url
   447	        self.provider_type = provider_type
   448	        self.temperature = temperature
   449	        self.max_tokens = max_tokens
   450	        
   451	        # 检查基本配置
   452	        if not api_key or not base_url:
   453	            self.available = False
   454	            print("警告: 自定义API需要提供api_key和base_url")
   455	        else:
   456	            self.available = True
   457	    
   458	    def generate_response(self, prompt: str, context: Optional[Dict] = None) -> str:
   459	        """生成响应"""
   460	        if not self.available:
   461	            return "自定义API不可用，请检查配置"
   462	        
   463	        try:
   464	            self.request_count += 1
   465	            
   466	            # 基础认证头
   467	            headers = {
   468	                "Authorization": f"Bearer {self.api_key}",
   469	                "Content-Type": "application/json"
   470	            }
   471	            
   472	            # 对于OpenRouter，添加官方推荐的认证头
   473	            if "openrouter.ai" in self.base_url:
   474	                headers.update({
   475	                    "HTTP-Referer": "https://github.com/ai-training-assistant",
   476	                    "X-Title": "AI Training Assistant"
   477	                })
   478	            
   479	            # 构建消息
   480	            messages = []
   481	            
   482	            # 添加系统消息
   483	            system_message = self._get_system_prompt()
   484	            if system_message:
   485	                messages.append({"role": "system", "content": system_message})
   486	            
   487	            # 添加上下文（如果有）
   488	            if context:
   489	                context_str = self._format_context(context)
   490	                if context_str:
   491	                    messages.append({"role": "assistant", "content": context_str})
   492	            
   493	            # 添加用户消息
   494	            messages.append({"role": "user", "content": prompt})
   495	            
   496	            # 构建请求数据
   497	            data = {
   498	                "model": self.model,
   499	                "messages": messages,
   500	                "temperature": self.temperature,
   501	                "max_tokens": self.max_tokens
   502	            }
   503	            
   504	            # 发送请求
   505	            response = requests.post(
   506	                f"{self.base_url}/chat/completions",
   507	                headers=headers,
   508	                json=data,
