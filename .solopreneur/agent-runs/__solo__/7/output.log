   725	                    if 'suggestions' in json_data and isinstance(json_data['suggestions'], list):
   726	                        print(f"[DEBUG] 成功解析JSON建议: {len(json_data['suggestions'])} 个建议")
   727	                        return json_data['suggestions']
   728	                except json.JSONDecodeError as e:
   729	                    print(f"[DEBUG] JSON解析失败: {str(e)}")
   730	                    continue
