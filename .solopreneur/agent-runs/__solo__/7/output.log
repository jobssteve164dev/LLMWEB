   603	@app.post("/v1/jobs/{job_id}/control", tags=["web"])
   604	def control_job(job_id: str, body: JobControl, db: Db, identity: WebAuth) -> dict[str, str]:
   605	    job = db.get(Job, job_id)
   606	    if job is None or job.workspace_id != identity.workspace_id:
   607	        raise HTTPException(status_code=404, detail="任务不存在")
   608	    if job.status in {"completed", "failed", "cancelled"}:
   609	        raise HTTPException(status_code=409, detail="任务已经结束")
   610	    if body.action == "pause":
   611	        job.desired_state = "paused"
   612	    elif body.action == "resume":
   613	        job.desired_state = "running"
   614	    else:
   615	        job.desired_state = "cancelled"
   616	        if job.status == "queued":
   617	            job.status = "cancelled"
   618	            job.finished_at = utc_now()
   619	            if job.experiment_id:
   620	                experiment = db.get(Experiment, job.experiment_id)
   621	                if experiment:
   622	                    experiment.status = "cancelled"
   623	                    experiment.current_stage = job.kind
   624	                for pending in db.scalars(select(Job).where(Job.experiment_id == job.experiment_id, Job.status.in_(["queued", "blocked"]))):
   625	                    pending.status = "cancelled"
   626	                    pending.finished_at = utc_now()
   627	    db.commit()
   628	    return {"job_id": job.id, "desired_state": job.desired_state}
