   579	@app.post("/v1/experiments/{experiment_id}/select-checkpoint", tags=["web"])
   580	def select_checkpoint(experiment_id: str, body: CheckpointSelect, db: Db, identity: WebAuth) -> dict[str, str]:
   581	    experiment = db.get(Experiment, experiment_id)
   582	    if experiment is None or experiment.workspace_id != identity.workspace_id:
   583	        raise HTTPException(status_code=404, detail="训练不存在")
   584	    if experiment.status != "awaiting_selection":
   585	        raise HTTPException(status_code=409, detail="当前训练还没有可选择的版本")
   586	    references = {str(item.get("reference")) for item in experiment.checkpoints or []}
   587	    if body.checkpoint_ref not in references:
   588	        raise HTTPException(status_code=400, detail="选择的模型版本不属于本次训练")
   589	    experiment.selected_checkpoint = body.checkpoint_ref
   590	    experiment.status = "running"
   591	    experiment.current_stage = "evaluate"
   592	    evaluate_job = db.scalar(select(Job).where(Job.experiment_id == experiment.id, Job.kind == "evaluate"))
   593	    export_job = db.scalar(select(Job).where(Job.experiment_id == experiment.id, Job.kind == "export"))
   594	    if evaluate_job is None or export_job is None:
   595	        raise HTTPException(status_code=409, detail="训练流程不完整，无法继续评测")
   596	    evaluate_job.payload = {**evaluate_job.payload, "selected_checkpoint": body.checkpoint_ref}
   597	    export_job.payload = {**export_job.payload, "selected_checkpoint": body.checkpoint_ref}
   598	    evaluate_job.status = "queued"
   599	    db.commit()
   600	    return {"experiment_id": experiment.id, "selected_checkpoint": body.checkpoint_ref}
