   442	def previous_jobs_complete(db: Session, job: Job) -> bool:
   443	    if job.experiment_id is None:
   444	        return True
   445	    previous = list(db.scalars(select(Job).where(Job.experiment_id == job.experiment_id, Job.sequence < job.sequence)))
