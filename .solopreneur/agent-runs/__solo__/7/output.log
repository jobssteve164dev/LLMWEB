   305	    def _start_training_iteration(self):
   306	        """开始训练迭代"""
   307	        try:
   308	            self.current_iteration += 1
   309	            
   310	            if self.current_iteration > self.config['max_iterations']:
   311	                self._complete_training_session()
   312	                return
   313	            
   314	            self.status_updated.emit(f"开始第 {self.current_iteration} 次训练迭代")
   315	            
   316	            # 记录迭代开始
   317	            iteration_record = {
   318	                'iteration': self.current_iteration,
   319	                'start_time': time.time(),
   320	                'config': self.current_session.current_config.copy(),
   321	                'status': 'running'
   322	            }
   323	            self.current_session.training_iterations.append(iteration_record)
   324	            
   325	            # 启动训练
   326	            self.state_manager.start_training()
   327	            self.model_trainer.train_model_with_config(self.current_session.current_config)
   328	            
   329	        except Exception as e:
   330	            self.error_occurred.emit(f"启动训练迭代失败: {str(e)}")
   331	            self._on_training_failed({'error': str(e)})
   332	    
   333	    def _start_monitoring(self):
   334	        """开始监控训练"""
   335	        try:
   336	            # 防重复启动监控线程
   337	            if self.monitoring_thread and self.monitoring_thread.is_alive():
   338	                print(f"[INFO] 监控线程已在运行，跳过重复启动 | thread={self.monitoring_thread.name}")
   339	                return
   340	            self.stop_monitoring = False
   341	            self.monitoring_thread = threading.Thread(target=self._monitoring_loop, name="IntelligentMonitoringThread")
   342	            self.monitoring_thread.daemon = True
   343	            print(f"[DEBUG] 启动监控线程 | thread={self.monitoring_thread.name} | session={self.current_session.session_id if self.current_session else 'None'}")
   344	            self.monitoring_thread.start()
   345	            
   346	        except Exception as e:
   347	            self.error_occurred.emit(f"启动监控失败: {str(e)}")
   348	    
   349	    def _monitoring_loop(self):
   350	        """监控循环"""
   351	        try:
   352	            while not self.stop_monitoring and self.is_running:
   353	                # 检查训练状态
   354	                if self._should_analyze_and_optimize():
   355	                    # 再次检查停止标志，防止在分析过程中被停止
   356	                    if not self.stop_monitoring and self.is_running:
   357	                        # 原子化获取分析锁，防止重复进入
   358	                        acquired = self._analyze_lock.acquire(blocking=False)
   359	                        if acquired:
   360	                            try:
   361	                                if not self.is_analyzing:
   362	                                    print(f"[DEBUG] 进入分析 | iter={self.current_iteration} | analyzing={self.is_analyzing} | thread={threading.current_thread().name}")
   363	                                    self._analyze_and_optimize()
   364	                            finally:
   365	                                self._analyze_lock.release()
   366	                
   367	                # 使用配置的监控间隔时间
   368	                monitoring_interval = self.config.get('monitoring_interval', 30)
   369	                for _ in range(monitoring_interval):  # 使用配置的间隔时间
   370	                    if self.stop_monitoring or not self.is_running:
   371	                        break
   372	                    time.sleep(1)  # 每秒检查一次停止标志
   373	                
   374	        except Exception as e:
   375	            self.error_occurred.emit(f"监控循环出错: {str(e)}")
   376	    
   377	    def _generate_training_round_id(self, epoch: int, iteration: int) -> str:
   378	        """生成训练轮次唯一ID - 基于确定性因子，确保同一轮训练生成相同ID"""
   379	        import hashlib
   380	        
   381	        # 基于确定性因子生成唯一ID，不使用时间戳避免重复生成不同ID
   382	        session_id = getattr(self.current_session, 'session_id', 'unknown')
   383	        
   384	        # 使用确定性因子：会话ID + iteration + epoch + 分析间隔
   385	        # 这样同一轮训练（相同的session、iteration、epoch）总是生成相同的ID
   386	        analysis_interval = self.config.get('analysis_interval', 5)
   387	        id_source = f"{session_id}_{iteration}_{epoch}_{analysis_interval}"
   388	        round_id = hashlib.md5(id_source.encode('utf-8')).hexdigest()[:12]
   389	        
   390	        print(f"[DEBUG] 生成训练轮次ID: {round_id} | session={session_id} | epoch={epoch} | iteration={iteration}")
   391	        return round_id
   392	    
   393	    def _get_or_create_training_round_id(self, epoch: int) -> str:
   394	        """获取或创建训练轮次ID - 确保一轮训练只有一个ID"""
   395	        with self._round_id_lock:
   396	            # 如果当前已有轮次ID，直接返回
   397	            if self.current_training_round_id:
   398	                print(f"[DEBUG] 使用现有轮次ID: {self.current_training_round_id}")
   399	                return self.current_training_round_id
   400	            
   401	            # 生成新的轮次ID
   402	            round_id = self._generate_training_round_id(epoch, self.current_iteration)
   403	            self.current_training_round_id = round_id
   404	            print(f"[DEBUG] 创建新轮次ID: {round_id}")
   405	            return round_id
   406	    
   407	    def _should_analyze_and_optimize(self) -> bool:
   408	        """判断是否应该进行分析和优化"""
   409	        try:
   410	            # 如果正在分析中，直接返回False
   411	            if self.is_analyzing:
   412	                return False
   413	            
   414	            # 获取当前训练数据
   415	            real_data = self.metrics_collector.get_current_training_data_for_ai()
   416	            if 'error' in real_data:
   417	                return False
   418	            
   419	            current_metrics = real_data.get('current_metrics', {})
   420	            epoch = current_metrics.get('epoch', 0)
   421	            
   422	            # 检查是否已经分析过这个epoch
   423	            if epoch <= self.last_analysis_epoch:
   424	                return False
   425	            
   426	            # 添加调试日志
   427	            self.status_updated.emit(f"🔍 检查分析条件: epoch={epoch}, min_iteration_epochs={self.config['min_iteration_epochs']}, analysis_interval={self.config['analysis_interval']}")
   428	            
   429	            # 检查是否达到最小训练轮数
   430	            if epoch < self.config['min_iteration_epochs']:
   431	                self.status_updated.emit(f"⏳ 未达到最小训练轮数: {epoch} < {self.config['min_iteration_epochs']}")
   432	                return False
   433	            
   434	            # 检查是否达到分析间隔
   435	            if epoch % self.config['analysis_interval'] != 0:
   436	                self.status_updated.emit(f"⏳ 未达到分析间隔: {epoch} % {self.config['analysis_interval']} != 0")
   437	                return False
   438	            
   439	            # 获取或创建训练轮次ID
   440	            round_id = self._get_or_create_training_round_id(epoch)
   441	            
   442	            # 检查是否已处理过此轮次
   443	            if round_id in self.processed_round_ids:
   444	                print(f"[DEBUG] 训练轮次已处理过，跳过 | round_id={round_id}")
   445	                self.status_updated.emit(f"⚠️ 训练轮次已处理过: {round_id}")
   446	                return False
   447	            
   448	            self.status_updated.emit(f"✅ 满足分析条件: epoch={epoch} | round_id={round_id}")
   449	            return True
   450	            
   451	        except Exception as e:
   452	            self.error_occurred.emit(f"检查分析条件失败: {str(e)}")
   453	            return False
   454	    
   455	    def _analyze_and_optimize(self):
   456	        """分析和优化"""
   457	        try:
   458	            # 设置分析标志，防止重复分析
   459	            self.is_analyzing = True
   460	            print(f"[DEBUG] _analyze_and_optimize 开始 | iter={self.current_iteration} | thread={threading.current_thread().name}")
   461	            
   462	            # 获取当前epoch并记录
   463	            real_data = self.metrics_collector.get_current_training_data_for_ai()
   464	            if 'error' not in real_data:
   465	                current_metrics = real_data.get('current_metrics', {})
   466	                epoch = current_metrics.get('epoch', 0)
   467	                self.last_analysis_epoch = epoch
   468	                print(f"[DEBUG] 本次分析epoch={epoch} | last_analysis_epoch={self.last_analysis_epoch}")
   469	            
   470	            self.status_updated.emit("正在进行智能分析和优化...")
   471	            
   472	            # 生成优化配置，传递训练轮次ID
   473	            optimized_config = self.config_generator.generate_optimized_config(
   474	                self.current_session.current_config, None, self.current_training_round_id
   475	            )
   476	            print(f"[DEBUG] 生成优化配置完成 | has_change={optimized_config != self.current_session.current_config}")
   477	            
   478	            # 检查配置是否有变化
   479	            if optimized_config != self.current_session.current_config:
   480	                self.status_updated.emit("检测到配置优化机会，准备重启训练...")
   481	                
   482	                # 更新当前会话的配置
   483	                self.current_session.current_config = optimized_config
   484	                
   485	                # 开始智能重启过程
   486	                restart_context = {
   487	                    'config': optimized_config,
   488	                    'session_id': self.current_session.session_id if self.current_session else None,
   489	                    'reason': 'parameter_optimization'
   490	                }
   491	                # 同一epoch仅触发一次应用
   492	                if epoch <= self.last_apply_epoch:
   493	                    print(f"[DEBUG] 本epoch已触发过应用，跳过 | epoch={epoch} | last_apply_epoch={self.last_apply_epoch}")
   494	                else:
   495	                    self.last_apply_epoch = epoch
   496	                    self.state_manager.start_intelligent_restart(restart_context)
   497	                
   498	                # 停止当前训练
   499	                if self.model_trainer:
   500	                    self.model_trainer.stop(is_intelligent_restart=True)
   501	                
   502	                # 等待训练停止
   503	                time.sleep(2)
   504	                
   505	                # 通过信号请求应用配置（避免在后台线程中直接操作UI）
   506	                print(f"[DEBUG] 发出apply_config_requested | iter={self.current_iteration} | session={self.current_session.session_id}")
   507	                if epoch == self.last_apply_epoch:
   508	                    self.apply_config_requested.emit(restart_context)
   509	            else:
   510	                self.status_updated.emit("当前配置已是最优，无需调整")
   511	            
   512	        except Exception as e:
   513	            self.error_occurred.emit(f"分析和优化失败: {str(e)}")
   514	        finally:
   515	            # 标记当前轮次ID为已处理
   516	            if self.current_training_round_id:
   517	                with self._round_id_lock:
   518	                    self.processed_round_ids.add(self.current_training_round_id)
   519	                    print(f"[DEBUG] 标记轮次ID为已处理: {self.current_training_round_id}")
   520	                    self.current_training_round_id = None
   521	            
   522	            # 无论成功还是失败，都要重置分析标志
   523	            self.is_analyzing = False
   524	            print(f"[DEBUG] _analyze_and_optimize 结束 | iter={self.current_iteration} | thread={threading.current_thread().name}")
   525	    
   526	    def _on_training_completed(self, result: Dict[str, Any]):
   527	        """训练完成回调"""
   528	        try:
   529	            if not self.current_session:
   530	                return
   531	            
   532	            # 更新迭代记录
   533	            if self.current_session.training_iterations:
   534	                current_iteration = self.current_session.training_iterations[-1]
   535	                current_iteration['end_time'] = time.time()
   536	                current_iteration['status'] = 'completed'
   537	                current_iteration['final_metrics'] = result.get('metrics', {})
   538	            
   539	            # 更新最佳结果
   540	            metrics = result.get('metrics', {})
   541	            if self._is_better_than_current_best(metrics):
   542	                self.current_session.best_metrics = metrics
   543	                self.current_session.best_config = self.current_session.current_config.copy()
   544	            
   545	            # 生成本轮训练的统一报告
   546	            self._generate_iteration_report(metrics)
   547	            
   548	            # 发射迭代完成信号
   549	            self.iteration_completed.emit({
   550	                'iteration': self.current_iteration,
   551	                'metrics': metrics,
   552	                'config': self.current_session.current_config,
   553	                'timestamp': time.time()
   554	            })
   555	            
   556	            # 检查是否仍在运行状态
   557	            if not self.is_running or self.stop_monitoring:
   558	                self.status_updated.emit("训练已停止，不继续下一轮")
   559	                return
   560	            
   561	            # 检查是否继续下一轮
   562	            if self._should_continue_training(metrics):
   563	                self.status_updated.emit("训练完成，准备下一轮优化...")
   564	                time.sleep(3)  # 等待一段时间
   565	                
   566	                # 再次检查运行状态，防止在等待期间被停止
   567	                if self.is_running and not self.stop_monitoring:
   568	                    self._start_training_iteration()
   569	                else:
   570	                    self.status_updated.emit("训练已停止，取消下一轮")
   571	            else:
   572	                self._complete_training_session()
   573	            
   574	        except Exception as e:
   575	            self.error_occurred.emit(f"处理训练完成事件失败: {str(e)}")
   576	    
   577	    def _on_training_failed(self, error_message: str):
   578	        """训练失败回调"""
   579	        try:
   580	            if not self.current_session:
   581	                return
   582	            
   583	            # 更新迭代记录
   584	            if self.current_session.training_iterations:
   585	                current_iteration = self.current_session.training_iterations[-1]
   586	                current_iteration['end_time'] = time.time()
   587	                current_iteration['status'] = 'failed'
   588	                current_iteration['error'] = error_message
   589	            
   590	            # 生成失败的迭代报告（包含错误信息）
   591	            failed_metrics = {
   592	                'status': 'failed',
   593	                'error': error_message,
   594	                'epoch': 0,  # 训练失败时可能没有完成任何epoch
   595	                'accuracy': 0.0,
   596	                'loss': float('inf')
   597	            }
   598	            self._generate_iteration_report(failed_metrics)
   599	            
   600	            self.status_updated.emit(f"训练失败: {error_message}")
   601	            
   602	            # 检查是否仍在运行状态
   603	            if not self.is_running or self.stop_monitoring:
   604	                self.status_updated.emit("训练已停止，不进行重试")
   605	                return
   606	            
   607	            # 检查是否重试
   608	            if self.current_iteration < self.config['max_iterations']:
   609	                self.status_updated.emit("准备重试训练...")
   610	                time.sleep(5)  # 等待一段时间
   611	                
   612	                # 再次检查运行状态，防止在等待期间被停止
   613	                if self.is_running and not self.stop_monitoring:
   614	                    self._start_training_iteration()
   615	                else:
   616	                    self.status_updated.emit("训练已停止，取消重试")
   617	            else:
   618	                self._complete_training_session()
   619	            
   620	        except Exception as e:
   621	            self.error_occurred.emit(f"处理训练失败事件失败: {str(e)}")
