   406	  return <div className="gpuLive"><div><span>GPU 使用率</span><strong>{utilization.toFixed(0)}%</strong></div><div><span>显存</span><strong>{(used / 1024).toFixed(1)} / {(total / 1024).toFixed(1)} GB</strong></div><div><span>温度</span><strong>{hottest || "—"}{hottest ? "°C" : ""}</strong></div></div>;
