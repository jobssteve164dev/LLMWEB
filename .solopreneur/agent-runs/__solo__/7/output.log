    16	class TrainingStreamServer:
    17	    """统一的训练数据流服务器"""
    18	    
    19	    def __init__(self, training_system=None, config=None):
    20	        """
    21	        初始化数据流服务器
    22	        
    23	        Args:
    24	            training_system: 训练系统实例
    25	            config: 服务器配置
    26	        """
    27	        self.training_system = training_system
    28	        self.config = config or self._get_default_config()
    29	        self.logger = logging.getLogger(__name__)
    30	        
    31	        # 初始化各个服务组件
    32	        self.sse_handler = SSEHandler(
    33	            max_clients=self.config.get('sse_max_clients', 50),
    34	            buffer_size=self.config.get('buffer_size', 1000)
    35	        )
    36	        
    37	        self.websocket_handler = WebSocketHandler(
    38	            host=self.config.get('websocket_host', '127.0.0.1'),
    39	            port=self.config.get('websocket_port', 8889)
    40	        )
    41	        
    42	        self.rest_api = TrainingAPI(training_system)
    43	        
    44	        # 服务器状态
    45	        self.is_running = False
    46	        self.server_threads = {}
    47	        
    48	        # 连接训练系统信号
    49	        self._connect_training_signals()
    50	    
    51	    def _get_default_config(self) -> Dict[str, Any]:
    52	        """获取默认配置"""
    53	        return {
    54	            'sse_host': '127.0.0.1',
    55	            'sse_port': 8888,
    56	            'sse_max_clients': 50,
    57	            'websocket_host': '127.0.0.1',
    58	            'websocket_port': 8889,
    59	            'rest_api_host': '127.0.0.1',
    60	            'rest_api_port': 8890,
    61	            'buffer_size': 1000,
    62	            'auto_start_all': True,
    63	            'debug_mode': False
    64	        }
    65	    
    66	    def _connect_training_signals(self):
    67	        """连接训练系统的信号"""
    68	        if not self.training_system:
    69	            return
    70	        
    71	        try:
    72	            # 连接训练指标更新信号
    73	            if hasattr(self.training_system, 'epoch_finished'):
    74	                self.training_system.epoch_finished.connect(self.broadcast_metrics)
    75	            
    76	            # 连接其他训练相关信号
    77	            if hasattr(self.training_system, 'progress_updated'):
    78	                self.training_system.progress_updated.connect(self._on_progress_updated)
    79	            
    80	            if hasattr(self.training_system, 'status_updated'):
    81	                self.training_system.status_updated.connect(self._on_status_updated)
    82	            
    83	            self.logger.info("成功连接训练系统信号")
    84	            
    85	        except Exception as e:
    86	            self.logger.warning(f"连接训练系统信号失败: {str(e)}")
    87	    
    88	    def start_all_servers(self):
    89	        """启动所有服务器"""
    90	        self.logger.info("启动所有数据流服务器...")
    91	        
    92	        try:
    93	            # 启动SSE服务器
    94	            self.logger.info("启动SSE服务器...")
    95	            self.start_sse_server()
    96	            
    97	            # 启动REST API服务器
    98	            self.logger.info("启动REST API服务器...")
    99	            self.start_rest_api_server()
   100	            
   101	            # 启动WebSocket服务器（最后启动）
   102	            self.logger.info("启动WebSocket服务器...")
   103	            self.start_websocket_server()
   104	            
   105	            self.is_running = True
   106	            self.logger.info("所有数据流服务器启动成功")
   107	            
   108	        except Exception as e:
   109	            self.logger.error(f"启动服务器时出错: {str(e)}")
   110	            import traceback
   111	            self.logger.error(f"详细错误信息: {traceback.format_exc()}")
   112	            self.stop_all_servers()
   113	            raise
   114	    
   115	    def start_sse_server(self):
   116	        """启动SSE服务器"""
   117	        def run_sse_server():
   118	            try:
   119	                self.sse_handler.start_server(
   120	                    host=self.config.get('sse_host', '127.0.0.1'),
   121	                    port=self.config.get('sse_port', 8888),
   122	                    debug=self.config.get('debug_mode', False)
   123	                )
   124	            except Exception as e:
   125	                self.logger.error(f"SSE服务器启动失败: {str(e)}")
   126	        
   127	        sse_thread = threading.Thread(target=run_sse_server, daemon=True)
   128	        sse_thread.start()
   129	        self.server_threads['sse'] = sse_thread
   130	        
   131	        # 等待服务器启动
   132	        time.sleep(1)
   133	        self.logger.info("SSE服务器已启动")
   134	    
   135	    def start_websocket_server(self):
   136	        """启动WebSocket服务器"""
   137	        try:
   138	            self.logger.info("创建WebSocket服务器线程...")
   139	            ws_thread = self.websocket_handler.start_server_thread()
   140	            self.server_threads['websocket'] = ws_thread
   141	            
   142	            # 等待服务器启动
   143	            self.logger.info("等待WebSocket服务器启动...")
   144	            time.sleep(3)
   145	            
   146	            # 检查WebSocket服务器状态
   147	            if self.websocket_handler.is_running:
   148	                self.logger.info("WebSocket服务器已启动")
   149	            else:
   150	                self.logger.warning("WebSocket服务器可能未完全启动")
   151	            
   152	        except Exception as e:
   153	            self.logger.error(f"WebSocket服务器启动失败: {str(e)}")
   154	            import traceback
   155	            self.logger.error(f"WebSocket启动详细错误: {traceback.format_exc()}")
   156	            raise
   157	    
   158	    def start_rest_api_server(self):
   159	        """启动REST API服务器"""
   160	        def run_rest_api_server():
   161	            try:
   162	                self.rest_api.start_server(
   163	                    host=self.config.get('rest_api_host', '127.0.0.1'),
   164	                    port=self.config.get('rest_api_port', 8890),
   165	                    debug=self.config.get('debug_mode', False)
   166	                )
   167	            except Exception as e:
   168	                self.logger.error(f"REST API服务器启动失败: {str(e)}")
   169	        
   170	        api_thread = threading.Thread(target=run_rest_api_server, daemon=True)
   171	        api_thread.start()
   172	        self.server_threads['rest_api'] = api_thread
   173	        
   174	        # 等待服务器启动
   175	        time.sleep(1)
   176	        self.logger.info("REST API服务器已启动")
   177	    
   178	    def stop_all_servers(self):
   179	        """停止所有服务器"""
   180	        self.logger.info("停止所有数据流服务器...")
   181	        
   182	        self.is_running = False
   183	        
   184	        # 停止SSE服务器
   185	        try:
   186	            self.sse_handler.stop_server()
   187	        except Exception as e:
   188	            self.logger.error(f"停止SSE服务器时出错: {str(e)}")
   189	        
   190	        # 停止WebSocket服务器
   191	        try:
   192	            self.websocket_handler.stop_server_sync()
   193	        except Exception as e:
   194	            self.logger.error(f"停止WebSocket服务器时出错: {str(e)}")
   195	        
   196	        # 停止REST API服务器
   197	        try:
   198	            self.rest_api.stop_server()
   199	        except Exception as e:
   200	            self.logger.error(f"停止REST API服务器时出错: {str(e)}")
   201	        
   202	        # 等待线程结束
   203	        for name, thread in self.server_threads.items():
   204	            if thread and thread.is_alive():
   205	                thread.join(timeout=5)
   206	                if thread.is_alive():
   207	                    self.logger.warning(f"{name}服务器线程未能正常结束")
   208	        
   209	        self.server_threads.clear()
   210	        self.logger.info("所有数据流服务器已停止")
   211	    
   212	    def broadcast_metrics(self, metrics: Dict[str, Any]):
   213	        """向所有客户端广播训练指标"""
   214	        if not self.is_running:
   215	            return
   216	        
   217	        try:
   218	            # 广播到SSE客户端
   219	            self.sse_handler.broadcast_metrics(metrics)
   220	            
   221	            # 广播到WebSocket客户端
   222	            self.websocket_handler.broadcast_metrics_sync(metrics)
   223	            
   224	            # 更新REST API的指标数据
   225	            self.rest_api.update_metrics(metrics)
   226	            
   227	        except Exception as e:
   228	            self.logger.error(f"广播指标时出错: {str(e)}")
   229	    
   230	    def _on_progress_updated(self, progress: int):
   231	        """处理训练进度更新"""
   232	        progress_data = {
