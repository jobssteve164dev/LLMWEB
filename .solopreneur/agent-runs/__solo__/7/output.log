   355	def infer_template(model_id: str) -> str:
   356	    normalized = model_id.lower()
   357	    if "qwen" in normalized:
   358	        return "qwen"
   359	    if "llama-3" in normalized or "llama3" in normalized:
   360	        return "llama3"
   361	    if "mistral" in normalized:
   362	        return "mistral"
   363	    if "gemma" in normalized:
   364	        return "gemma"
   365	    return "default"
