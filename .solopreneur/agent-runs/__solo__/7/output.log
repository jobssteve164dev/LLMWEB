   223	    
   224	    def _update_stats(self, endpoint: str):
   225	        """更新API统计信息"""
   226	        self.api_stats['requests_count'] += 1
   227	        if endpoint not in self.api_stats['endpoints_accessed']:
   228	            self.api_stats['endpoints_accessed'][endpoint] = 0
   229	        self.api_stats['endpoints_accessed'][endpoint] += 1
   230	    
   231	    def _calculate_recent_performance(self, recent_metrics: list) -> Dict[str, Any]:
   232	        """计算最近的性能指标"""
   233	        if not recent_metrics:
   234	            return {}
   235	        
   236	        # 提取训练损失和准确率
   237	        train_losses = []
   238	        val_accuracies = []
   239	        
   240	        for metric in recent_metrics:
   241	            data = metric.get('data', {})
   242	            if 'train_loss' in data:
   243	                train_losses.append(data['train_loss'])
   244	            if 'val_accuracy' in data:
   245	                val_accuracies.append(data['val_accuracy'])
   246	        
   247	        performance = {}
   248	        if train_losses:
   249	            performance['avg_train_loss'] = sum(train_losses) / len(train_losses)
   250	            performance['loss_trend'] = 'decreasing' if len(train_losses) > 1 and train_losses[-1] < train_losses[0] else 'stable'
   251	        
   252	        if val_accuracies:
   253	            performance['avg_val_accuracy'] = sum(val_accuracies) / len(val_accuracies)
   254	            performance['accuracy_trend'] = 'increasing' if len(val_accuracies) > 1 and val_accuracies[-1] > val_accuracies[0] else 'stable'
   255	        
   256	        return performance
   257	    
   258	    def _execute_training_control(self, action: str, data: Dict[str, Any]) -> Dict[str, Any]:
   259	        """执行训练控制操作"""
   260	        if not self.training_system:
   261	            return {'message': 'Training system not available'}
   262	        
   263	        if action == 'pause':
   264	            # 暂停训练
   265	            return {'message': 'Training paused', 'action': 'pause'}
   266	        elif action == 'resume':
   267	            # 恢复训练
   268	            return {'message': 'Training resumed', 'action': 'resume'}
   269	        elif action == 'stop':
   270	            # 停止训练
   271	            if hasattr(self.training_system, 'stop'):
   272	                self.training_system.stop()
   273	            return {'message': 'Training stopped', 'action': 'stop'}
   274	        elif action == 'get_config':
   275	            # 获取训练配置
   276	            return {'message': 'Training configuration', 'config': {}}
   277	        else:
   278	            raise ValueError(f'Unknown action: {action}')
   279	    
   280	    def _is_training_active(self) -> bool:
   281	        """检查训练是否正在进行"""
   282	        if not self.training_system:
   283	            return False
   284	        
   285	        # 检查训练系统状态
   286	        if hasattr(self.training_system, 'training_thread'):
   287	            return (self.training_system.training_thread and 
   288	                   self.training_system.training_thread.isRunning())
   289	        
   290	        return False
   291	    
   292	    def update_metrics(self, metrics: Dict[str, Any]):
   293	        """更新训练指标"""
   294	        # 格式化指标数据
   295	        formatted_metrics = {
   296	            'timestamp': time.time(),
   297	            'event_type': 'metrics_update',
   298	            'data': metrics
   299	        }
   300	        
   301	        # 更新当前指标和历史记录
   302	        self.current_metrics = metrics
   303	        self.metrics_history.append(formatted_metrics)
   304	        
   305	        # 保持历史记录在合理范围内
   306	        if len(self.metrics_history) > 1000:
   307	            self.metrics_history = self.metrics_history[-500:]
   308	    
   309	    def start_server(self, host='127.0.0.1', port=8890, debug=False):
   310	        """启动REST API服务器"""
   311	        self.logger.info(f"启动REST API服务器: http://{host}:{port}")
   312	        self.is_running = True
   313	        self.app.run(host=host, port=port, debug=debug, threaded=True)
   314	    
   315	    def stop_server(self):
   316	        """停止REST API服务器"""
   317	        self.logger.info("停止REST API服务器...")
   318	        self.is_running = False
   319	        # Flask应用会在主线程结束时自动停止
   320	    
   321	    def get_app(self):
   322	        """获取Flask应用实例"""
   323	        return self.app 
     1	"""
     2	Stream Server - 统一的训练数据流服务器
     3	
     4	整合SSE、WebSocket和REST API三种数据接口，提供统一的训练指标数据流服务。
     5	"""
     6	
     7	import threading
     8	import time
     9	import logging
    10	from typing import Dict, Any, Optional
    11	from .sse_handler import SSEHandler
    12	from .websocket_handler import WebSocketHandler
    13	from .rest_api import TrainingAPI
    14	
