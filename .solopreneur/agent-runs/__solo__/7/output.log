   656	    def _is_better_than_current_best(self, metrics: Dict[str, Any]) -> bool:
   657	        """判断当前结果是否比最佳结果更好"""
   658	        try:
   659	            if not self.current_session.best_metrics:
   660	                return True
   661	            
   662	            current_val_acc = metrics.get('val_accuracy', 0)
   663	            best_val_acc = self.current_session.best_metrics.get('val_accuracy', 0)
   664	            
   665	            # 如果验证准确率提升超过阈值，认为更好
   666	            return current_val_acc > best_val_acc + self.config['improvement_threshold']
   667	            
   668	        except Exception as e:
   669	            self.error_occurred.emit(f"比较结果失败: {str(e)}")
   670	            return False
   671	    
   672	    def _should_continue_training(self, metrics: Dict[str, Any]) -> bool:
   673	        """判断是否应该继续训练"""
   674	        try:
   675	            # 检查是否达到最大迭代次数
   676	            if self.current_iteration >= self.config['max_iterations']:
   677	                return False
   678	            
   679	            # 检查是否收敛
   680	            if self._is_converged(metrics):
   681	                return False
   682	            
   683	            # 检查是否有改进空间
   684	            if not self._has_improvement_potential(metrics):
   685	                return False
   686	            
   687	            return True
   688	            
   689	        except Exception as e:
   690	            self.error_occurred.emit(f"判断是否继续训练失败: {str(e)}")
   691	            return False
   692	    
   693	    def _is_converged(self, metrics: Dict[str, Any]) -> bool:
   694	        """判断是否已收敛"""
   695	        try:
   696	            val_acc = metrics.get('val_accuracy', 0)
   697	            
   698	            # 如果验证准确率很高，认为已收敛
   699	            if val_acc > 0.95:
   700	                return True
   701	            
   702	            # 检查最近几次迭代的改进
   703	            if len(self.current_session.training_iterations) >= 3:
   704	                recent_improvements = []
   705	                for i in range(-3, 0):
   706	                    if i < 0:
   707	                        iteration = self.current_session.training_iterations[i]
   708	                        if 'final_metrics' in iteration:
   709	                            recent_improvements.append(iteration['final_metrics'].get('val_accuracy', 0))
   710	                
   711	                if len(recent_improvements) >= 3:
   712	                    # 计算改进幅度
   713	                    improvement = max(recent_improvements) - min(recent_improvements)
   714	                    if improvement < self.config['convergence_threshold']:
   715	                        return True
   716	            
   717	            return False
   718	            
   719	        except Exception as e:
   720	            self.error_occurred.emit(f"判断收敛状态失败: {str(e)}")
   721	            return False
   722	    
   723	    def _has_improvement_potential(self, metrics: Dict[str, Any]) -> bool:
   724	        """判断是否还有改进空间"""
   725	        try:
   726	            val_acc = metrics.get('val_accuracy', 0)
   727	            val_loss = metrics.get('val_loss', 1.0)
   728	            
   729	            # 如果准确率较低或损失较高，还有改进空间
   730	            return val_acc < 0.9 or val_loss > 0.1
   731	            
   732	        except Exception as e:
   733	            self.error_occurred.emit(f"判断改进空间失败: {str(e)}")
   734	            return True
   735	    
   736	    def _complete_training_session(self):
   737	        """完成训练会话"""
   738	        try:
   739	            if not self.current_session:
   740	                return
   741	            
   742	            self.current_session.status = 'completed'
   743	            self.is_running = False
   744	            self.stop_monitoring = True
   745	            
   746	            # 停止配置生成器会话
   747	            self.config_generator.stop_training_session()
   748	            
   749	            # 发射完成信号
   750	            self.training_completed.emit({
   751	                'session_id': self.current_session.session_id,
   752	                'total_iterations': self.current_iteration,
   753	                'best_metrics': self.current_session.best_metrics,
   754	                'best_config': self.current_session.best_config,
   755	                'timestamp': time.time()
   756	            })
   757	            
   758	            self.status_updated.emit(f"智能训练完成，共进行了 {self.current_iteration} 次迭代")
   759	            
   760	        except Exception as e:
   761	            self.error_occurred.emit(f"完成训练会话失败: {str(e)}")
