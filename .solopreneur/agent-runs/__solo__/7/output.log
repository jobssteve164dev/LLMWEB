   461	    def _generate_analysis_cache_key(self, config: Dict[str, Any], metrics: Dict[str, Any]) -> str:
   462	        """生成分析缓存键，确保相同输入使用相同分析结果"""
   463	        try:
   464	            import hashlib
   465	            
   466	            # 提取关键配置参数
   467	            key_config = {
   468	                'model_name': config.get('model_name'),
   469	                'batch_size': config.get('batch_size'),
   470	                'learning_rate': config.get('learning_rate'),
   471	                'optimizer': config.get('optimizer'),
   472	                'num_epochs': config.get('num_epochs'),
   473	                'use_augmentation': config.get('use_augmentation'),
   474	                'use_class_weights': config.get('use_class_weights'),
   475	                'weight_strategy': config.get('weight_strategy'),
   476	                'lr_scheduler': config.get('lr_scheduler'),
   477	                'early_stopping': config.get('early_stopping'),
   478	                'early_stopping_patience': config.get('early_stopping_patience'),
   479	                'mixed_precision': config.get('mixed_precision'),
   480	                'dropout_rate': config.get('dropout_rate'),
   481	                'weight_decay': config.get('weight_decay'),
   482	                'warmup_enabled': config.get('warmup_enabled'),
   483	                'warmup_steps': config.get('warmup_steps'),
   484	                'warmup_ratio': config.get('warmup_ratio'),
   485	                'gradient_accumulation_enabled': config.get('gradient_accumulation_enabled'),
   486	                'gradient_accumulation_steps': config.get('gradient_accumulation_steps'),
   487	                'advanced_augmentation_enabled': config.get('advanced_augmentation_enabled'),
   488	                'cutmix_prob': config.get('cutmix_prob'),
   489	                'mixup_alpha': config.get('mixup_alpha'),
   490	                'label_smoothing_enabled': config.get('label_smoothing_enabled'),
   491	                'label_smoothing': config.get('label_smoothing'),
   492	                'model_ema': config.get('model_ema'),
   493	                'model_ema_decay': config.get('model_ema_decay')
   494	            }
   495	            
   496	            # 提取关键训练指标
   497	            key_metrics = {
   498	                'epoch': metrics.get('epoch'),
   499	                'train_loss': round(metrics.get('train_loss', 0), 4),
   500	                'val_loss': round(metrics.get('val_loss', 0), 4),
   501	                'train_accuracy': round(metrics.get('train_accuracy', 0), 4),
   502	                'val_accuracy': round(metrics.get('val_accuracy', 0), 4),
   503	                'learning_rate': round(metrics.get('learning_rate', 0), 6)
   504	            }
   505	            
   506	            # 生成哈希键
   507	            cache_data = {
   508	                'config': key_config,
   509	                'metrics': key_metrics,
   510	                'timestamp': int(time.time() // 60)  # 按分钟缓存，避免过于频繁的缓存失效
   511	            }
   512	            
   513	            cache_string = json.dumps(cache_data, sort_keys=True, ensure_ascii=False)
   514	            cache_key = hashlib.md5(cache_string.encode('utf-8')).hexdigest()
   515	            
   516	            return cache_key
   517	            
   518	        except Exception as e:
   519	            print(f"[WARNING] 生成缓存键失败: {str(e)}")
   520	            return f"fallback_{int(time.time())}"
   521	    
   522	    def _analyze_config_and_metrics(self, 
   523	                                  config: Dict[str, Any], 
   524	                                  metrics: Dict[str, Any]) -> Dict[str, Any]:
   525	        """分析配置和训练指标"""
   526	        try:
   527	            # 添加调试信息
   528	            adapter_type = type(self.llm_framework.llm_adapter).__name__
   529	            self.status_updated.emit(f"🔍 开始LLM分析，使用适配器: {adapter_type}")
   530	            print(f"[DEBUG] 使用LLM适配器: {adapter_type}")
   531	            print(f"[DEBUG] 适配器类型: {getattr(self.llm_framework.llm_adapter, 'adapter_type', 'unknown')}")
   532	            
   533	            # 构建分析提示词
   534	            prompt = self._build_config_analysis_prompt(config, metrics)
   535	            print(f"[DEBUG] 分析提示词长度: {len(prompt)} 字符")
   536	            
   537	            # 使用LLM进行分析
   538	            self.status_updated.emit("🤖 正在调用LLM进行训练分析...")
   539	            print(f"[DEBUG] 开始调用LLM分析...")
   540	            
   541	            analysis_result = self.llm_framework.llm_adapter.analyze_metrics(metrics, prompt)
   542	            
   543	            print(f"[DEBUG] LLM分析结果类型: {type(analysis_result)}")
   544	            print(f"[DEBUG] LLM分析结果长度: {len(str(analysis_result))} 字符")
   545	            
   546	            # 检查是否是模拟结果
   547	            if isinstance(analysis_result, str) and "模拟分析结果" in analysis_result:
   548	                self.status_updated.emit("⚠️ 检测到模拟分析结果！请配置真实的LLM服务")
   549	                print("[WARNING] 检测到模拟分析结果，请配置真实的LLM服务")
   550	            else:
   551	                self.status_updated.emit("✅ LLM分析完成")
   552	                print("[DEBUG] LLM分析完成，结果看起来是真实的")
   553	            
   554	            return analysis_result
