   345	class LocalLLMAdapter(LLMAdapter):
   346	    """本地LLM适配器 (支持Ollama等)"""
   347	    
   348	    def __init__(self, model_name: str = 'llama2', base_url: str = 'http://localhost:11434', 
   349	                 timeout: int = 300):
   350	        super().__init__(model_name)
   351	        self.base_url = base_url
   352	        self.timeout = timeout  # 默认2分钟超时
   353	        self.available = self._check_availability()
   354	    
   355	    def _check_availability(self) -> bool:
   356	        """检查本地LLM服务是否可用"""
   357	        try:
   358	            response = requests.get(f"{self.base_url}/api/tags", timeout=5)
   359	            return response.status_code == 200
   360	        except Exception:
   361	            return False
   362	    
   363	    def generate_response(self, prompt: str, context: Optional[Dict] = None) -> str:
   364	        """生成响应"""
   365	        if not self.available:
   366	            return "本地LLM服务不可用，请检查Ollama是否运行在 " + self.base_url
   367	        
   368	        try:
   369	            self.request_count += 1
   370	            
   371	            full_prompt = self._build_full_prompt(prompt, context)
   372	            
   373	            response = requests.post(
   374	                f"{self.base_url}/api/generate",
   375	                json={
   376	                    'model': self.model_name,
   377	                    'prompt': full_prompt,
   378	                    'stream': False,
   379	                    'options': {
   380	                        'temperature': 0.1,  # 降低温度以确保一致性
   381	                        'num_predict': 1000
   382	                    }
   383	                },
   384	                timeout=self.timeout
   385	            )
   386	            
   387	            if response.status_code == 200:
   388	                result = response.json()
   389	                return result.get('response', '无响应')
   390	            else:
   391	                return f"本地LLM调用失败: HTTP {response.status_code}"
   392	                
   393	        except requests.exceptions.Timeout:
   394	            return f"本地LLM响应超时（{self.timeout}秒），请检查模型是否过大或服务器负载过高。建议：\n1. 尝试使用更小的模型\n2. 增加超时时间\n3. 检查服务器资源使用情况"
   395	        except requests.exceptions.ConnectionError:
   396	            return f"无法连接到本地LLM服务 ({self.base_url})，请确保Ollama服务正在运行"
   397	        except Exception as e:
   398	            return f"本地LLM调用异常: {str(e)}"
   399	    
   400	    def analyze_metrics(self, metrics_data: Dict, custom_prompt: str = None) -> str:
   401	        """分析训练指标"""
   402	        if custom_prompt:
   403	            return self.generate_response(custom_prompt)
   404	        
   405	        prompt = f"""
   406	作为深度学习专家，请分析以下CV模型训练指标:
   407	
   408	{json.dumps(metrics_data, ensure_ascii=False, indent=2)}
   409	
   410	请提供:
   411	1. 训练状态分析
   412	2. 性能评估
   413	3. 优化建议
   414	4. 问题诊断
   415	
   416	用中文回答，保持专业性。
   417	"""
   418	        return self.generate_response(prompt)
   419	    
   420	    def _build_full_prompt(self, prompt: str, context: Optional[Dict] = None) -> str:
   421	        """构建完整提示词"""
   422	        system_prompt = """
   423	你是一个专业的深度学习训练分析师。请基于提供的数据进行分析，
   424	给出具体的建议和解决方案。回答要简洁明了，用中文回答。
   425	"""
   426	        
   427	        full_prompt = system_prompt + "\n\n"
   428	        
   429	        if context:
   430	            full_prompt += f"上下文: {json.dumps(context, ensure_ascii=False)}\n\n"
   431	        
   432	        full_prompt += f"用户问题: {prompt}"
   433	        
   434	        return full_prompt
   435	
