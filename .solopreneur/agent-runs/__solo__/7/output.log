   623	    def _generate_iteration_report(self, metrics: Dict[str, Any]):
   624	        """生成本轮训练的统一报告"""
   625	        try:
   626	            if not self.current_session:
   627	                return
   628	            
   629	            # 获取当前轮次ID（如果没有则创建）
   630	            epoch = metrics.get('epoch', 0)
   631	            round_id = self._get_or_create_training_round_id(epoch)
   632	            
   633	            # 检查是否已经为此轮次ID生成过报告
   634	            with self._round_id_lock:
   635	                if round_id in self.processed_round_ids:
   636	                    print(f"[DEBUG] 轮次ID已生成过报告，跳过 | round_id={round_id}")
   637	                    return
   638	                
   639	                # 标记此轮次ID为已处理
   640	                self.processed_round_ids.add(round_id)
   641	                print(f"[DEBUG] 标记轮次ID为已生成报告: {round_id}")
   642	            
   643	            # 使用智能配置生成器的新方法生成统一的迭代报告
   644	            report_path = self.config_generator.generate_iteration_summary_report(
   645	                self.current_iteration, metrics, round_id
   646	            )
   647	            
   648	            if report_path:
   649	                self.status_updated.emit(f"📄 第{self.current_iteration}轮训练总结报告已生成: {os.path.basename(report_path)}")
   650	            else:
   651	                self.status_updated.emit(f"⚠️ 第{self.current_iteration}轮训练报告生成失败")
   652	            
   653	        except Exception as e:
   654	            self.error_occurred.emit(f"生成迭代报告失败: {str(e)}")
