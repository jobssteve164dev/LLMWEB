   670	                return json_suggestions
   671	            
   672	            # 如果没有JSON格式，则进行文本解析
   673	            print(f"[DEBUG] 未找到JSON格式建议，进行文本解析")
   674	            lines = text.split('\n')
   675	            current_suggestion = None
   676	            
   677	            for line in lines:
   678	                line = line.strip()
   679	                if not line:
   680	                    continue
   681	                    
   682	                # 检测建议项（以数字开头或包含关键词）
   683	                if (line.startswith(('1.', '2.', '3.', '4.', '5.', '6.', '7.', '8.', '9.')) or
   684	                    any(keyword in line.lower() for keyword in ['建议', '推荐', '调整', '优化', '增加', '减少', '降低', '提高'])):
   685	                    
   686	                    if current_suggestion:
   687	                        suggestions.append(current_suggestion)
   688	                    
   689	                    current_suggestion = {
   690	                        'type': 'parameter_adjustment',
   691	                        'description': line,
   692	                        'priority': 'medium',
   693	                        'confidence': 0.7
   694	                    }
   695	                elif current_suggestion and line.startswith(('  ', '\t', '-', '*')):
   696	                    # 这是建议的详细说明
   697	                    current_suggestion['description'] += f" {line.strip()}"
   698	            
   699	            if current_suggestion:
   700	                suggestions.append(current_suggestion)
   701	                
   702	        except Exception as e:
   703	            print(f"[DEBUG] 解析文本建议失败: {str(e)}")
