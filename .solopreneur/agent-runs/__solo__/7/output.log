    15	class LLMAdapter(ABC):
    16	    """LLM适配器基类"""
    17	    
    18	    def __init__(self, model_name: str = None):
    19	        self.model_name = model_name
    20	        self.request_count = 0
    21	        self.total_tokens = 0
    22	        
    23	    @abstractmethod
    24	    def generate_response(self, prompt: str, context: Optional[Dict] = None) -> str:
    25	        """生成响应"""
    26	        pass
    27	    
    28	    @abstractmethod
    29	    def analyze_metrics(self, metrics_data: Dict, custom_prompt: str = None) -> str:
    30	        """分析训练指标"""
    31	        pass
    32	    
    33	    def get_stats(self) -> Dict:
    34	        """获取使用统计"""
    35	        return {
    36	            'model_name': self.model_name,
    37	            'request_count': self.request_count,
    38	            'total_tokens': self.total_tokens
    39	        }
