   339	    def generate_optimized_config(self, 
   340	                                current_config: Dict[str, Any],
   341	                                training_metrics: Dict[str, Any] = None,
   342	                                training_round_id: str = None) -> Dict[str, Any]:
   343	        """生成优化的训练配置"""
   344	        try:
   345	            self.status_updated.emit("正在生成优化配置...")
   346	            print(f"[DEBUG] generate_optimized_config called | thread={threading.current_thread().name}")
   347	            
   348	            # 获取实时训练数据
   349	            if training_metrics is None:
   350	                real_data = self.metrics_collector.get_current_training_data_for_ai()
   351	                if 'error' in real_data:
   352	                    self.error_occurred.emit(f"无法获取训练数据: {real_data['error']}")
   353	                    return current_config
   354	                training_metrics = real_data.get('current_metrics', {})
   355	            print(f"[DEBUG] metrics epoch={training_metrics.get('epoch')} train_loss={training_metrics.get('train_loss')} val_loss={training_metrics.get('val_loss')}")
   356	            
   357	            # 生成缓存键，确保相同输入使用相同分析结果
   358	            cache_key = self._generate_analysis_cache_key(current_config, training_metrics)
   359	            print(f"[DEBUG] analysis cache_key={cache_key}")
   360	            
   361	            # 检查是否可以使用缓存的分析结果
   362	            if (self._cached_analysis_key == cache_key and 
   363	                self._cached_analysis_result is not None):
   364	                self.status_updated.emit("使用缓存的分析结果确保一致性...")
   365	                analysis_result = self._cached_analysis_result
   366	                print("[DEBUG] 使用缓存分析结果")
   367	            else:
   368	                # 使用LLM分析当前配置和训练数据
   369	                analysis_result = self._analyze_config_and_metrics(current_config, training_metrics)
   370	                # 缓存分析结果
   371	                self._cached_analysis_result = analysis_result
   372	                self._cached_analysis_key = cache_key
   373	                print("[DEBUG] 写入缓存分析结果")
   374	            
   375	            # 生成优化建议
   376	            optimization_suggestions = self._generate_optimization_suggestions(
   377	                current_config, training_metrics, analysis_result
   378	            )
   379	            print(f"[DEBUG] 建议数量={len(optimization_suggestions)}")
   380	            
   381	            # 应用优化建议到配置
   382	            optimized_config = self._apply_optimization_suggestions(
   383	                current_config, optimization_suggestions
   384	            )
   385	            print("[DEBUG] 应用建议完成")
   386	            
   387	            # 验证配置有效性
   388	            validated_config = self._validate_config(optimized_config)
   389	            
   390	            # 智能冲突自动修复
   391	            print("[DEBUG] 开始智能冲突检测与自动修复...")
   392	            llm_changes = {}
   393	            for suggestion in optimization_suggestions:
   394	                param_name = suggestion.get('parameter')
   395	                suggested_value = suggestion.get('suggested_value')
   396	                if param_name and suggested_value is not None:
   397	                    llm_changes[param_name] = suggested_value
   398	            
   399	            conflict_resolved_config, resolutions = self.conflict_resolver.resolve_conflicts_automatically(
   400	                validated_config, llm_changes
   401	            )
   402	            
   403	            if resolutions:
   404	                print(f"[DEBUG] 智能冲突修复完成，修复了 {len(resolutions)} 个冲突")
   405	                validated_config = conflict_resolved_config
   406	            
   407	            # 记录配置调整
   408	            # 确保analysis_result是字典格式
   409	            if isinstance(analysis_result, str):
   410	                # 如果分析结果是字符串，提取其中的关键信息
   411	                analysis_dict = {
   412	                    'reason': 'LLM智能分析建议',
   413	                    'analysis': analysis_result[:500] + '...' if len(analysis_result) > 500 else analysis_result
   414	                }
   415	            else:
   416	                analysis_dict = analysis_result
   417	            
   418	            # 如果有冲突修复，添加修复信息到分析结果
   419	            if resolutions:
   420	                analysis_dict['conflict_resolutions'] = [
   421	                    {
   422	                        'type': r.conflict_type,
   423	                        'strategy': r.resolution_strategy,
   424	                        'reason': r.reason,
   425	                        'confidence': r.confidence_level
   426	                    } for r in resolutions
   427	                ]
   428	
   429	            # 生成最终生效建议（与原始LLM建议对齐，标注差异）
   430	            try:
   431	                final_suggestions = []
   432	                # 使用当前配置与最终配置对比，生成最终生效建议
   433	                for key, final_value in validated_config.items():
   434	                    # 仅记录与当前配置不同的键
   435	                    if key in current_config and current_config[key] != final_value:
   436	                        item = {
   437	                            'parameter': key,
   438	                            'final_value': final_value
   439	                        }
   440	                        # 如果存在原始建议，附带原始建议值
   441	                        if key in llm_changes:
   442	                            item['original_suggested_value'] = llm_changes[key]
   443	                            item['changed_by'] = 'conflict_resolution' if (key in llm_changes and llm_changes[key] != final_value) else 'llm_suggestion'
   444	                        final_suggestions.append(item)
   445	                analysis_dict['final_suggestions'] = final_suggestions
   446	            except Exception as _:
   447	                # 安静失败，不影响主流程
   448	                pass
   449	
   450	            self._record_config_adjustment(
   451	                current_config, validated_config, training_metrics, analysis_dict, training_round_id
   452	            )
   453	            
   454	            self.status_updated.emit("优化配置生成完成")
   455	            return validated_config
   456	            
   457	        except Exception as e:
   458	            self.error_occurred.emit(f"生成优化配置失败: {str(e)}")
   459	            return current_config
