   335	    def cleanup_old_data(self, days_to_keep: int = 7):
   336	        """清理旧的数据文件"""
   337	        try:
   338	            current_time = time.time()
   339	            cutoff_time = current_time - (days_to_keep * 24 * 3600)
   340	            
   341	            for filename in os.listdir(self.data_dir):
   342	                if filename.endswith('_metrics.json'):
   343	                    file_path = os.path.join(self.data_dir, filename)
   344	                    if os.path.getmtime(file_path) < cutoff_time:
   345	                        os.remove(file_path)
   346	                        print(f"🗑️ 已清理旧数据文件: {filename}")
   347	                        
   348	        except Exception as e:
   349	            print(f"❌ 清理旧数据失败: {str(e)}")
