   253	                except json.JSONDecodeError:
   254	                    # 如果文件损坏，重新创建
   255	                    data = {
   256	                        "session_id": self.current_training_session,
   257	                        "start_time": time.time(),
   258	                        "metrics_history": [],
   259	                        "current_metrics": {},
   260	                        "training_status": "running"
   261	                    }
   262	            else:
   263	                data = {
   264	                    "session_id": self.current_training_session,
   265	                    "start_time": time.time(),
   266	                    "metrics_history": [],
   267	                    "current_metrics": {},
   268	                    "training_status": "running"
   269	                }
   270	            
   271	            # 添加新指标
   272	            data["metrics_history"].append(cleaned_metric)
   273	            data["current_metrics"] = cleaned_metric
   274	            data["last_update"] = time.time()
   275	            
   276	            # 保持历史数据在合理范围内
   277	            if len(data["metrics_history"]) > self.max_history:
   278	                data["metrics_history"] = data["metrics_history"][-self.max_history:]
   279	            
   280	            # 写回文件
   281	            with open(self.data_file_path, 'w', encoding='utf-8') as f:
   282	                json.dump(data, f, indent=2, ensure_ascii=False)
   283	                
   284	            # 发送数据文件就绪信号
   285	            self.analysis_data_ready.emit(self.data_file_path)
   286	            
   287	        except Exception as e:
   288	            print(f"❌ 更新数据文件失败: {str(e)}")
