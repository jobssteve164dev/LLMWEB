     1	"""
     2	WebSocket Handler - WebSocket实时通信处理器
     3	
     4	提供训练指标的双向WebSocket通信服务，支持实时数据推送和命令控制。
     5	"""
     6	
     7	import json
     8	import asyncio
     9	import websockets
    10	import threading
    11	import time
    12	from typing import Dict, Any, Set
    13	from websockets.server import WebSocketServerProtocol
    14	import logging
    15	
    16	
    17	class WebSocketHandler:
    18	    """WebSocket实时通信处理器"""
    19	    
    20	    def __init__(self, host='127.0.0.1', port=8889):
    21	        """
    22	        初始化WebSocket处理器
    23	        
    24	        Args:
    25	            host: 服务器主机地址
    26	            port: 服务器端口
    27	        """
    28	        self.host = host
    29	        self.port = port
    30	        self.clients: Set[WebSocketServerProtocol] = set()
    31	        self.server = None
    32	        self.is_running = False
    33	        self.metrics_history = []
    34	        self.logger = logging.getLogger(__name__)
    35	        
    36	        # 支持的消息类型
    37	        self.message_handlers = {
    38	            'subscribe': self._handle_subscribe,
    39	            'unsubscribe': self._handle_unsubscribe,
    40	            'get_history': self._handle_get_history,
    41	            'ping': self._handle_ping
    42	        }
    43	    
    44	    async def _handle_connection(self, websocket: WebSocketServerProtocol):
    45	        """处理WebSocket连接（兼容websockets库）"""
    46	        await self.register_client(websocket, "/")
    47	    
    48	    async def register_client(self, websocket: WebSocketServerProtocol, path: str):
    49	        """注册新的WebSocket客户端"""
    50	        self.clients.add(websocket)
    51	        self.logger.info(f"新WebSocket客户端连接: {websocket.remote_address}, 当前连接数: {len(self.clients)}")
    52	        
    53	        try:
    54	            # 发送连接确认
    55	            await websocket.send(json.dumps({
    56	                'type': 'connection',
    57	                'status': 'connected',
    58	                'client_id': id(websocket),
    59	                'timestamp': time.time()
    60	            }))
    61	            
    62	            # 发送最近的历史数据
    63	            if self.metrics_history:
    64	                recent_metrics = self.metrics_history[-5:]  # 最近5条记录
    65	                for metrics in recent_metrics:
    66	                    await websocket.send(json.dumps(metrics))
    67	            
    68	            # 监听客户端消息
    69	            async for message in websocket:
    70	                await self._handle_client_message(websocket, message)
    71	                
    72	        except websockets.exceptions.ConnectionClosed:
    73	            self.logger.info(f"WebSocket客户端断开连接: {websocket.remote_address}")
    74	        except Exception as e:
    75	            self.logger.error(f"WebSocket客户端处理错误: {str(e)}")
    76	        finally:
    77	            self.clients.discard(websocket)
    78	            self.logger.info(f"WebSocket客户端已移除，当前连接数: {len(self.clients)}")
    79	    
    80	    async def _handle_client_message(self, websocket: WebSocketServerProtocol, message: str):
    81	        """处理客户端消息"""
    82	        try:
    83	            data = json.loads(message)
    84	            message_type = data.get('type')
    85	            
    86	            if message_type in self.message_handlers:
    87	                response = await self.message_handlers[message_type](websocket, data)
    88	                if response:
    89	                    await websocket.send(json.dumps(response))
    90	            else:
    91	                await websocket.send(json.dumps({
    92	                    'type': 'error',
    93	                    'message': f'Unknown message type: {message_type}'
    94	                }))
    95	                
    96	        except json.JSONDecodeError:
    97	            await websocket.send(json.dumps({
    98	                'type': 'error',
    99	                'message': 'Invalid JSON format'
   100	            }))
   101	        except Exception as e:
   102	            self.logger.error(f"处理客户端消息时出错: {str(e)}")
   103	            await websocket.send(json.dumps({
   104	                'type': 'error',
   105	                'message': str(e)
   106	            }))
   107	    
   108	    async def _handle_subscribe(self, websocket: WebSocketServerProtocol, data: Dict[str, Any]):
   109	        """处理订阅请求"""
   110	        subscription_type = data.get('subscription', 'all')
   111	        return {
   112	            'type': 'subscription_confirmed',
   113	            'subscription': subscription_type,
   114	            'client_id': id(websocket)
   115	        }
   116	    
   117	    async def _handle_unsubscribe(self, websocket: WebSocketServerProtocol, data: Dict[str, Any]):
   118	        """处理取消订阅请求"""
   119	        return {
   120	            'type': 'unsubscription_confirmed',
   121	            'client_id': id(websocket)
   122	        }
   123	    
   124	    async def _handle_get_history(self, websocket: WebSocketServerProtocol, data: Dict[str, Any]):
   125	        """处理获取历史数据请求"""
   126	        limit = data.get('limit', 10)
   127	        history = self.metrics_history[-limit:] if self.metrics_history else []
   128	        
   129	        return {
   130	            'type': 'history_data',
   131	            'data': history,
   132	            'count': len(history),
   133	            'total': len(self.metrics_history)
   134	        }
   135	    
   136	    async def _handle_ping(self, websocket: WebSocketServerProtocol, data: Dict[str, Any]):
   137	        """处理心跳请求"""
   138	        return {
   139	            'type': 'pong',
   140	            'timestamp': time.time(),
   141	            'client_id': id(websocket)
   142	        }
   143	    
   144	    async def broadcast_metrics(self, metrics: Dict[str, Any]):
   145	        """广播训练指标到所有连接的客户端"""
   146	        if not self.clients:
   147	            return
   148	        
   149	        # 格式化指标数据
   150	        formatted_metrics = {
   151	            'type': 'metrics_update',
   152	            'timestamp': time.time(),
   153	            'data': metrics
   154	        }
   155	        
   156	        # 添加到历史记录
   157	        self.metrics_history.append(formatted_metrics)
   158	        # 保持历史记录在合理范围内
   159	        if len(self.metrics_history) > 1000:
   160	            self.metrics_history = self.metrics_history[-500:]
   161	        
   162	        # 广播到所有客户端
   163	        if self.clients:
   164	            # 创建所有发送任务
   165	            tasks = []
   166	            dead_clients = []
   167	            
   168	            for client in self.clients.copy():
   169	                try:
   170	                    task = client.send(json.dumps(formatted_metrics))
   171	                    tasks.append(task)
   172	                except websockets.exceptions.ConnectionClosed:
   173	                    dead_clients.append(client)
   174	                except Exception as e:
   175	                    self.logger.warning(f"向客户端发送数据时出错: {str(e)}")
   176	                    dead_clients.append(client)
   177	            
   178	            # 清理死连接
   179	            for dead_client in dead_clients:
   180	                self.clients.discard(dead_client)
   181	            
   182	            # 并发发送所有消息
   183	            if tasks:
   184	                await asyncio.gather(*tasks, return_exceptions=True)
   185	    
   186	    def broadcast_metrics_sync(self, metrics: Dict[str, Any]):
   187	        """同步方式广播指标（从其他线程调用）"""
   188	        if not self.is_running:
   189	            return
   190	        
   191	        # 在新的事件循环中运行异步广播
   192	        try:
   193	            loop = asyncio.new_event_loop()
   194	            asyncio.set_event_loop(loop)
   195	            loop.run_until_complete(self.broadcast_metrics(metrics))
   196	            loop.close()
   197	        except Exception as e:
   198	            self.logger.error(f"同步广播指标时出错: {str(e)}")
   199	    
   200	    async def start_server(self):
   201	        """启动WebSocket服务器"""
   202	        self.is_running = True
   203	        self.logger.info(f"启动WebSocket服务器: ws://{self.host}:{self.port}")
   204	        
   205	        try:
   206	            self.server = await websockets.serve(
   207	                self._handle_connection,
   208	                self.host,
   209	                self.port,
   210	                ping_interval=20,
   211	                ping_timeout=10
   212	            )
   213	            self.logger.info(f"WebSocket服务器启动成功: ws://{self.host}:{self.port}")
   214	            return self.server
   215	        except OSError as e:
   216	            if e.errno == 10048:  # 端口已被占用
   217	                self.logger.error(f"端口 {self.port} 已被占用，尝试停止现有服务器...")
   218	                # 强制重置状态
   219	                self.is_running = False
   220	                self.server = None
   221	                raise Exception(f"端口 {self.port} 已被占用，请确保没有其他WebSocket服务器在运行")
   222	            else:
   223	                raise
   224	    
   225	    def start_server_thread(self):
   226	        """在独立线程中启动WebSocket服务器"""
   227	        def run_server():
   228	            loop = asyncio.new_event_loop()
   229	            asyncio.set_event_loop(loop)
   230	            
   231	            async def server_main():
   232	                await self.start_server()
   233	                # 保持服务器运行，直到is_running变为False
   234	                while self.is_running:
   235	                    await asyncio.sleep(0.1)
   236	            
   237	            try:
   238	                loop.run_until_complete(server_main())
   239	            except KeyboardInterrupt:
   240	                self.logger.info("WebSocket服务器收到停止信号")
   241	            except Exception as e:
   242	                self.logger.error(f"WebSocket服务器运行出错: {str(e)}")
   243	            finally:
   244	                try:
   245	                    # 确保服务器完全关闭
   246	                    if self.server:
   247	                        try:
   248	                            self.server.close()
   249	                        except:
   250	                            pass
   251	                    loop.close()
   252	                except:
   253	                    pass
   254	        
   255	        server_thread = threading.Thread(target=run_server, daemon=True)
   256	        server_thread.start()
   257	        return server_thread
   258	    
   259	    async def stop_server(self):
   260	        """停止WebSocket服务器"""
   261	        self.is_running = False
   262	        
   263	        # 向所有客户端发送断开通知
   264	        if self.clients:
   265	            disconnect_message = json.dumps({
   266	                'type': 'server_shutdown',
   267	                'message': 'Server is shutting down',
   268	                'timestamp': time.time()
   269	            })
   270	            
   271	            tasks = []
   272	            for client in self.clients.copy():
   273	                try:
   274	                    tasks.append(client.send(disconnect_message))
   275	                except:
   276	                    pass
   277	            
   278	            if tasks:
   279	                await asyncio.gather(*tasks, return_exceptions=True)
   280	        
   281	        # 关闭服务器
   282	        if self.server:
   283	            try:
   284	                self.server.close()
   285	                await self.server.wait_closed()
   286	            except Exception as e:
   287	                self.logger.error(f"关闭WebSocket服务器时出错: {str(e)}")
   288	        
   289	        self.clients.clear()
   290	        self.logger.info("WebSocket服务器已停止")
   291	    
   292	    def stop_server_sync(self):
   293	        """同步方式停止WebSocket服务器"""
   294	        if not self.is_running:
   295	            return
   296	        
   297	        try:
   298	            # 强制重置状态
   299	            self.is_running = False
   300	            self.clients.clear()
   301	            
   302	            # 直接关闭服务器，不使用异步方法
   303	            if self.server:
   304	                try:
   305	                    self.server.close()
   306	                    self.logger.info("WebSocket服务器已关闭")
   307	                except Exception as e:
   308	                    self.logger.error(f"关闭WebSocket服务器时出错: {str(e)}")
   309	                finally:
   310	                    self.server = None
   311	            else:
   312	                self.server = None
   313	                
   314	            # 等待一段时间确保端口释放
   315	            import time
   316	            time.sleep(1)
   317	                
   318	        except Exception as e:
   319	            self.logger.error(f"同步停止WebSocket服务器时出错: {str(e)}")
   320	            # 强制重置状态
   321	            self.is_running = False
   322	            self.clients.clear()
   323	            self.server = None
   324	    
