   450	def lease_job(db: Db, response: Response, authorization: Annotated[str | None, Header()] = None) -> dict[str, Any] | None:
   451	    runner = require_runner(db, authorization)
   452	    candidates = list(db.scalars(select(Job).where(Job.runner_id == runner.id, Job.status == "queued").order_by(Job.created_at, Job.sequence)))
   453	    job = next((item for item in candidates if previous_jobs_complete(db, item)), None)
   454	    if job is None:
   455	        response.status_code = status.HTTP_204_NO_CONTENT
   456	        return None
   457	    lease_id = new_id("lease")
   458	    job.lease_id = lease_id
   459	    job.status = "leased"
   460	    job.leased_at = utc_now()
   461	    runner.current_job_id = job.id
   462	    runner.status = "busy"
   463	    runner.last_seen_at = utc_now()
   464	    if job.experiment_id:
   465	        experiment = db.get(Experiment, job.experiment_id)
   466	        if experiment:
   467	            experiment.status = "running"
   468	            experiment.current_stage = job.kind
   469	    db.commit()
   470	    return {"job_id": job.id, "lease_id": lease_id, "kind": job.kind, "payload": job.payload, "desired_state": job.desired_state}
