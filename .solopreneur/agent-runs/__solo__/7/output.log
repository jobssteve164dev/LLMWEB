   513	@app.post("/v1/runners/jobs/{job_id}/events", status_code=status.HTTP_202_ACCEPTED, tags=["runner"])
   514	def ingest_events(job_id: str, body: EventBatch, db: Db, authorization: Annotated[str | None, Header()] = None) -> dict[str, int]:
   515	    runner = require_runner(db, authorization)
   516	    job = db.get(Job, job_id)
   517	    if job is None or job.runner_id != runner.id or job.lease_id != body.lease_id:
   518	        raise HTTPException(status_code=409, detail="任务租约无效")
   519	    accepted = 0
   520	    for incoming in body.events:
   521	        if db.scalar(select(JobEvent).where(JobEvent.event_id == incoming.event_id)) is not None:
   522	            continue
   523	        event = JobEvent(job_id=job.id, event_id=incoming.event_id, type=incoming.type, message=incoming.message, payload=incoming.payload)
   524	        db.add(event)
   525	        accepted += 1
   526	        if incoming.type == "accepted":
   527	            job.status = "running"
   528	            job.started_at = job.started_at or utc_now()
   529	        elif incoming.type == "progress":
   530	            job.progress = max(0, min(100, int(incoming.payload.get("percent", job.progress))))
   531	            if job.status == "paused" and job.desired_state == "running":
   532	                job.status = "running"
   533	        elif incoming.type == "paused":
   534	            job.status = "paused"
   535	        elif incoming.type == "completed":
   536	            job.status = "completed"
   537	            job.progress = 100
   538	            job.finished_at = utc_now()
   539	            update_completed_result(db, job, incoming.payload)
   540	            runner.current_job_id = None
   541	            runner.status = "online"
   542	        elif incoming.type == "failed":
   543	            job.status = "failed"
   544	            job.error = incoming.message or "任务执行失败"
   545	            job.finished_at = utc_now()
   546	            runner.current_job_id = None
   547	            runner.status = "online"
   548	            if job.dataset_id and job.kind == "inspect":
   549	                dataset = db.get(Dataset, job.dataset_id)
   550	                if dataset:
   551	                    dataset.status = "failed"
   552	            if job.experiment_id:
   553	                experiment = db.get(Experiment, job.experiment_id)
   554	                if experiment:
   555	                    experiment.status = "failed"
   556	                    experiment.current_stage = job.kind
   557	                for pending in db.scalars(select(Job).where(Job.experiment_id == job.experiment_id, Job.status.in_(["queued", "blocked"]))):
   558	                    pending.status = "cancelled"
   559	                    pending.finished_at = utc_now()
   560	        elif incoming.type == "cancelled":
   561	            job.status = "cancelled"
   562	            job.error = None
   563	            job.finished_at = utc_now()
   564	            runner.current_job_id = None
   565	            runner.status = "online"
   566	            if job.experiment_id:
   567	                experiment = db.get(Experiment, job.experiment_id)
   568	                if experiment:
   569	                    experiment.status = "cancelled"
   570	                    experiment.current_stage = job.kind
   571	                for pending in db.scalars(select(Job).where(Job.experiment_id == job.experiment_id, Job.status.in_(["queued", "blocked"]))):
   572	                    pending.status = "cancelled"
   573	                    pending.finished_at = utc_now()
   574	    runner.last_seen_at = utc_now()
   575	    db.commit()
   576	    return {"accepted": accepted}
