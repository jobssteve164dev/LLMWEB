   415	func parseRuntimeSpec(payload map[string]any) (runtimeSpec, error) {
   416		model := anyMap(payload["model"])
   417		training := anyMap(payload["training"])
   418		runtime := anyMap(payload["runtime"])
   419		output := anyMap(payload["output"])
   420		spec := runtimeSpec{
   421			ExperimentID: stringValue(payload, "experiment_id"),
   422			DatasetID:    stringValue(payload, "dataset_id"),
   423			ModelID:      stringValue(model, "id"),
   424			Revision:     stringValue(model, "revision"),
   425			Template:     stringValue(model, "template"),
   426			Method:       stringValue(training, "method"),
   427			Epochs:       numberValue(training, "epochs", 3),
   428			LearningRate: numberValue(training, "learning_rate", 0.0002),
   429			MaxLength:    int(numberValue(training, "max_length", 2048)),
   430			BatchSize:    int(numberValue(training, "batch_size", 1)),
   431			Accumulation: int(numberValue(training, "gradient_accumulation", 8)),
   432			Formats:      stringSlice(output["formats"]),
   433			Image:        stringValue(runtime, "image"),
   434			Preview:      boolValue(output, "preview_allowed"),
   435			Checkpoint:   stringValue(payload, "selected_checkpoint"),
   436			Destination:  stringValue(output, "destination"),
   437			S3URI:        stringValue(output, "s3_uri"),
   438			S3Endpoint:   stringValue(output, "s3_endpoint"),
   439		}
   440		if spec.ExperimentID == "" || spec.DatasetID == "" || spec.ModelID == "" {
   441			return runtimeSpec{}, errors.New("训练任务缺少实验、数据或模型信息")
   442		}
   443		if approvedModels[spec.ModelID] != spec.Revision {
   444			return runtimeSpec{}, errors.New("基础模型或版本不在首版批准范围内")
   445		}
   446		if spec.Template == "default" || spec.Template == "" {
   447			return runtimeSpec{}, fmt.Errorf("暂时无法为模型 %q 自动确定对话模板，请改用 Qwen、Llama 3、Mistral 或 Gemma 指令模型", spec.ModelID)
   448		}
   449		if spec.Checkpoint == "" {
   450			spec.Checkpoint = "adapter"
   451		}
   452		if spec.Checkpoint != "adapter" && (!strings.HasPrefix(spec.Checkpoint, "adapter/checkpoint-") || strings.Contains(spec.Checkpoint, "..")) {
   453			return runtimeSpec{}, errors.New("选择的模型版本引用无效")
   454		}
   455		if spec.Destination == "" {
   456			spec.Destination = "local"
   457		}
   458		if spec.Destination == "user_s3" && !strings.HasPrefix(spec.S3URI, "s3://") {
   459			return runtimeSpec{}, errors.New("S3 产物目标无效")
   460		}
   461		return spec, nil
   462	}
