     1	"""
     2	REST API - HTTP REST接口服务
     3	
     4	提供训练系统的HTTP REST API接口，支持指标查询、训练控制等功能。
     5	"""
     6	
     7	import json
     8	import time
     9	from typing import Dict, Any, Optional
    10	from flask import Flask, jsonify, request
    11	from flask_cors import CORS
    12	import logging
    13	
    14	
    15	class TrainingAPI:
    16	    """训练系统REST API服务"""
    17	    
    18	    def __init__(self, training_system=None):
    19	        """
    20	        初始化REST API服务
    21	        
    22	        Args:
    23	            training_system: 训练系统实例，用于控制训练过程
    24	        """
    25	        self.app = Flask(__name__)
    26	        CORS(self.app)
    27	        self.training_system = training_system
    28	        self.metrics_history = []
    29	        self.current_metrics = {}
    30	        self.logger = logging.getLogger(__name__)
    31	        
    32	        # 服务器状态
    33	        self.is_running = False
    34	        self.server_thread = None
    35	        
    36	        # 设置路由
    37	        self._setup_routes()
    38	        
    39	        # API统计信息
    40	        self.api_stats = {
    41	            'requests_count': 0,
    42	            'start_time': time.time(),
    43	            'endpoints_accessed': {}
    44	        }
    45	    
    46	    def _setup_routes(self):
    47	        """设置API路由"""
    48	        
    49	        # 指标相关接口
    50	        @self.app.route('/api/metrics/current', methods=['GET'])
    51	        def get_current_metrics():
    52	            """获取当前训练指标"""
    53	            self._update_stats('/api/metrics/current')
    54	            return jsonify({
    55	                'status': 'success',
    56	                'data': self.current_metrics,
    57	                'timestamp': time.time()
    58	            })
    59	        
    60	        @self.app.route('/api/metrics/history', methods=['GET'])
    61	        def get_metrics_history():
    62	            """获取历史训练指标"""
    63	            self._update_stats('/api/metrics/history')
    64	            
    65	            # 获取查询参数
    66	            limit = request.args.get('limit', 100, type=int)
    67	            offset = request.args.get('offset', 0, type=int)
    68	            metric_type = request.args.get('type', None)
    69	            
    70	            # 过滤和分页
    71	            filtered_metrics = self.metrics_history
    72	            if metric_type:
    73	                filtered_metrics = [m for m in filtered_metrics 
    74	                                  if m.get('event_type') == metric_type]
    75	            
    76	            total_count = len(filtered_metrics)
    77	            paginated_metrics = filtered_metrics[offset:offset + limit]
    78	            
    79	            return jsonify({
    80	                'status': 'success',
    81	                'data': {
    82	                    'metrics': paginated_metrics,
    83	                    'pagination': {
    84	                        'limit': limit,
    85	                        'offset': offset,
    86	                        'total': total_count,
    87	                        'has_more': offset + limit < total_count
    88	                    }
    89	                },
    90	                'timestamp': time.time()
    91	            })
    92	        
    93	        @self.app.route('/api/metrics/summary', methods=['GET'])
    94	        def get_metrics_summary():
    95	            """获取指标摘要统计"""
    96	            self._update_stats('/api/metrics/summary')
    97	            
    98	            if not self.metrics_history:
    99	                return jsonify({
   100	                    'status': 'success',
   101	                    'data': {'message': 'No metrics available'},
   102	                    'timestamp': time.time()
   103	                })
   104	            
   105	            # 计算摘要统计
   106	            recent_metrics = self.metrics_history[-10:] if len(self.metrics_history) >= 10 else self.metrics_history
   107	            
   108	            summary = {
   109	                'total_metrics': len(self.metrics_history),
   110	                'latest_epoch': self.current_metrics.get('epoch', 0),
   111	                'training_duration': time.time() - self.api_stats['start_time'],
   112	                'recent_performance': self._calculate_recent_performance(recent_metrics)
   113	            }
   114	            
   115	            return jsonify({
   116	                'status': 'success',
   117	                'data': summary,
   118	                'timestamp': time.time()
   119	            })
   120	        
   121	        # 训练控制接口
   122	        @self.app.route('/api/training/control', methods=['POST'])
   123	        def control_training():
   124	            """训练控制接口"""
   125	            self._update_stats('/api/training/control')
   126	            
   127	            try:
   128	                data = request.get_json()
   129	                if not data:
   130	                    return jsonify({
   131	                        'status': 'error',
   132	                        'message': 'No JSON data provided'
   133	                    }), 400
   134	                
   135	                action = data.get('action')
   136	                if not action:
   137	                    return jsonify({
   138	                        'status': 'error',
   139	                        'message': 'No action specified'
   140	                    }), 400
   141	                
   142	                # 执行训练控制操作
   143	                result = self._execute_training_control(action, data)
   144	                
   145	                return jsonify({
   146	                    'status': 'success',
   147	                    'data': result,
   148	                    'timestamp': time.time()
   149	                })
   150	                
   151	            except Exception as e:
   152	                self.logger.error(f"训练控制操作失败: {str(e)}")
   153	                return jsonify({
   154	                    'status': 'error',
   155	                    'message': str(e)
   156	                }), 500
   157	        
   158	        @self.app.route('/api/training/status', methods=['GET'])
   159	        def get_training_status():
   160	            """获取训练状态"""
   161	            self._update_stats('/api/training/status')
   162	            
   163	            status_info = {
   164	                'is_training': self._is_training_active(),
   165	                'current_epoch': self.current_metrics.get('epoch', 0),
   166	                'total_epochs': self.current_metrics.get('total_epochs', 0),
   167	                'model_name': self.current_metrics.get('model_name', 'Unknown'),
   168	                'training_speed': self.current_metrics.get('training_speed', 0),
   169	                'gpu_memory_usage': self.current_metrics.get('gpu_memory_used', 0)
   170	            }
   171	            
   172	            return jsonify({
   173	                'status': 'success',
   174	                'data': status_info,
   175	                'timestamp': time.time()
   176	            })
   177	        
   178	        # 系统信息接口
   179	        @self.app.route('/api/system/info', methods=['GET'])
   180	        def get_system_info():
   181	            """获取系统信息"""
   182	            self._update_stats('/api/system/info')
   183	            
   184	            system_info = {
   185	                'api_version': '1.0.0',
   186	                'uptime': time.time() - self.api_stats['start_time'],
   187	                'total_requests': self.api_stats['requests_count'],
   188	                'endpoints_stats': self.api_stats['endpoints_accessed'],
   189	                'metrics_count': len(self.metrics_history)
   190	            }
   191	            
   192	            return jsonify({
   193	                'status': 'success',
   194	                'data': system_info,
   195	                'timestamp': time.time()
   196	            })
   197	        
   198	        @self.app.route('/api/system/health', methods=['GET'])
   199	        def health_check():
   200	            """健康检查接口"""
   201	            return jsonify({
   202	                'status': 'healthy',
   203	                'timestamp': time.time(),
   204	                'uptime': time.time() - self.api_stats['start_time']
   205	            })
   206	        
   207	        # 错误处理
   208	        @self.app.errorhandler(404)
   209	        def not_found(error):
   210	            return jsonify({
   211	                'status': 'error',
   212	                'message': 'Endpoint not found',
   213	                'timestamp': time.time()
   214	            }), 404
   215	        
   216	        @self.app.errorhandler(500)
   217	        def internal_error(error):
   218	            return jsonify({
   219	                'status': 'error',
   220	                'message': 'Internal server error',
   221	                'timestamp': time.time()
