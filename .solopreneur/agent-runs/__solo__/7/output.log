   239	    def _update_data_file(self, new_metric: Dict[str, Any]):
   240	        """更新数据文件"""
   241	        if not self.data_file_path:
   242	            return
   243	            
   244	        try:
   245	            # 清理数据，移除不可序列化的对象
   246	            cleaned_metric = self._clean_metric_data(new_metric)
