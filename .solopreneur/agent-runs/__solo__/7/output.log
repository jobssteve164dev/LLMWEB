    42	class OpenAIAdapter(LLMAdapter):
    43	    """OpenAI模型适配器"""
    44	    
    45	    def __init__(self, api_key: str, model: str = 'gpt-4', base_url: Optional[str] = None):
    46	        super().__init__(model)
    47	        self.api_key = api_key
    48	        self.model = model
    49	        self.base_url = base_url or "https://api.openai.com/v1"
    50	        
    51	        # 尝试导入OpenAI库
    52	        try:
    53	            import openai
    54	            if base_url:
    55	                self.client = openai.OpenAI(api_key=api_key, base_url=base_url)
    56	            else:
    57	                self.client = openai.OpenAI(api_key=api_key)
    58	            self.available = True
    59	        except ImportError:
    60	            print("警告: OpenAI库未安装，将使用HTTP请求方式")
    61	            self.client = None
    62	            self.available = False
    63	    
    64	    def generate_response(self, prompt: str, context: Optional[Dict] = None) -> str:
    65	        """生成响应"""
    66	        try:
    67	            self.request_count += 1
    68	            
    69	            messages = [
    70	                {"role": "system", "content": self._get_system_prompt()},
    71	                {"role": "user", "content": prompt}
    72	            ]
    73	            
    74	            if context:
    75	                context_msg = f"上下文信息: {json.dumps(context, ensure_ascii=False)}"
    76	                messages.insert(1, {"role": "assistant", "content": context_msg})
    77	            
    78	            if self.client:
    79	                response = self.client.chat.completions.create(
    80	                    model=self.model,
    81	                    messages=messages,
    82	                    temperature=0.1,  # 降低温度以确保一致性
    83	                    max_tokens=1000
    84	                )
    85	                content = response.choices[0].message.content
    86	                self.total_tokens += response.usage.total_tokens
    87	                return content
    88	            else:
    89	                # 使用HTTP请求方式
    90	                return self._http_request(messages)
    91	                
    92	        except Exception as e:
    93	            return f"OpenAI API调用失败: {str(e)}"
    94	    
    95	    def analyze_metrics(self, metrics_data: Dict, custom_prompt: str = None) -> str:
    96	        """分析训练指标"""
    97	        print(f"[DEBUG] OpenAIAdapter.analyze_metrics 被调用")
    98	        print(f"[DEBUG] 使用自定义提示词: {custom_prompt is not None}")
    99	        print(f"[DEBUG] 模型: {self.model}")
   100	        print(f"[DEBUG] API密钥已配置: {bool(self.api_key)}")
   101	        print(f"[DEBUG] 客户端可用: {self.available}")
   102	        
   103	        if custom_prompt:
   104	            print(f"[DEBUG] 使用自定义提示词进行分析")
   105	            return self.generate_response(custom_prompt)
   106	        
   107	        prompt = f"""
   108	请分析以下CV模型训练指标并提供专业建议:
   109	
   110	训练指标:
   111	{json.dumps(metrics_data, ensure_ascii=False, indent=2)}
   112	
   113	请分析:
   114	1. 当前训练状态 (收敛情况、过拟合/欠拟合)
   115	2. 关键指标趋势
   116	3. 具体的优化建议
   117	4. 潜在问题诊断
   118	
   119	请用中文回答，并保持专业性。
   120	"""
   121	        print(f"[DEBUG] 使用默认提示词进行分析")
   122	        return self.generate_response(prompt)
   123	    
   124	    def _get_system_prompt(self) -> str:
   125	        """获取系统提示词"""
   126	        return """
   127	你是一个专业的深度学习训练分析师。你的任务是:
   128	1. 分析训练指标数据，识别训练状态
   129	2. 提供具体的优化建议
   130	3. 诊断常见的训练问题
   131	4. 使用专业但易懂的语言解释
   132	
   133	请始终基于提供的数据进行分析，避免过度推测。
   134	回答要简洁明了，重点突出，用中文回答。
   135	"""
   136	    
   137	    def _http_request(self, messages: List[Dict]) -> str:
   138	        """使用HTTP请求方式调用API"""
   139	        max_retries = 3
   140	        base_timeout = 300  # 增加超时时间到5分钟
   141	        
   142	        for attempt in range(max_retries):
   143	            try:
   144	                headers = {
   145	                    "Authorization": f"Bearer {self.api_key}",
   146	                    "Content-Type": "application/json"
   147	                }
   148	                
   149	                data = {
   150	                    "model": self.model,
   151	                    "messages": messages,
   152	                    "temperature": 0.7,
   153	                    "max_tokens": 1000
   154	                }
   155	                
   156	                # 使用指数退避策略增加超时时间
   157	                timeout = base_timeout * (2 ** attempt)
   158	                
   159	                response = requests.post(
   160	                    f"{self.base_url}/chat/completions",
   161	                    headers=headers,
   162	                    json=data,
   163	                    timeout=timeout
   164	                )
   165	                
   166	                if response.status_code == 200:
   167	                    result = response.json()
   168	                    content = result['choices'][0]['message']['content']
   169	                    self.total_tokens += result.get('usage', {}).get('total_tokens', 0)
   170	                    return content
   171	                else:
   172	                    error_msg = f"API请求失败: {response.status_code} - {response.text}"
   173	                    if attempt < max_retries - 1:
   174	                        print(f"第{attempt + 1}次尝试失败，准备重试: {error_msg}")
   175	                        time.sleep(2 ** attempt)  # 指数退避等待
   176	                        continue
   177	                    else:
   178	                        return error_msg
   179	                        
   180	            except requests.exceptions.Timeout as e:
   180	            except requests.exceptions.Timeout as e:
   181	                if attempt < max_retries - 1:
   182	                    print(f"第{attempt + 1}次请求超时（{timeout}秒），准备重试...")
   183	                    time.sleep(2 ** attempt)
   184	                    continue
   185	                else:
   186	                    return f"OpenAI API请求超时（已重试{max_retries}次）: {str(e)}"
   187	            except Exception as e:
   188	                if attempt < max_retries - 1:
   189	                    print(f"第{attempt + 1}次请求失败，准备重试: {str(e)}")
   190	                    time.sleep(2 ** attempt)
   191	                    continue
   192	                else:
   193	                    return f"OpenAI API请求失败（已重试{max_retries}次）: {str(e)}"
   194	
