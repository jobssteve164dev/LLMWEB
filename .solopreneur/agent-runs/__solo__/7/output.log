   624	    def _generate_optimization_suggestions(self, 
   625	                                         config: Dict[str, Any],
   626	                                         metrics: Dict[str, Any],
   627	                                         analysis_result: Any) -> List[Dict[str, Any]]:
   628	        """生成优化建议"""
   629	        suggestions = []
   630	        
   631	        try:
   632	            print(f"[DEBUG] 分析结果类型: {type(analysis_result)}")
   633	            print(f"[DEBUG] 分析结果内容: {str(analysis_result)[:200]}...")
   634	            
   635	            # 从LLM分析结果中提取建议
   636	            if isinstance(analysis_result, dict) and 'suggestions' in analysis_result:
   637	                suggestions.extend(analysis_result['suggestions'])
   638	            elif isinstance(analysis_result, str):
   639	                # 如果分析结果是字符串，尝试解析其中的建议
   640	                parsed_suggestions = self._parse_suggestions_from_text(analysis_result)
   641	                suggestions.extend(parsed_suggestions)
   642	            
   643	            # 基于规则生成额外建议
   644	            rule_suggestions = self._generate_rule_based_suggestions(config, metrics)
   645	            suggestions.extend(rule_suggestions)
   646	            
   647	            # 按优先级排序，确保相同优先级时按参数名排序以保证稳定性
   648	            suggestions.sort(key=lambda x: (x.get('priority', 'low'), x.get('parameter', '')), reverse=True)
   649	            
   650	            return suggestions
   651	            
   652	        except Exception as e:
   653	            self.error_occurred.emit(f"生成优化建议失败: {str(e)}")
   654	            print(f"[ERROR] 生成优化建议失败: {str(e)}")
   655	            import traceback
   656	            traceback.print_exc()
   657	            return []
   658	    
   659	    def _parse_suggestions_from_text(self, text: str) -> List[Dict[str, Any]]:
   660	        """从文本中解析建议"""
   661	        suggestions = []
   662	        
   663	        try:
   664	            print(f"[DEBUG] 开始解析LLM返回的文本建议")
   665	            
   666	            # 首先尝试提取JSON格式的建议
   667	            json_suggestions = self._extract_json_suggestions(text)
   668	            if json_suggestions:
   669	                print(f"[DEBUG] 成功提取到 {len(json_suggestions)} 个JSON格式建议")
   670	                return json_suggestions
   671	            
   672	            # 如果没有JSON格式，则进行文本解析
   673	            print(f"[DEBUG] 未找到JSON格式建议，进行文本解析")
   674	            lines = text.split('\n')
   675	            current_suggestion = None
   676	            
   677	            for line in lines:
   678	                line = line.strip()
   679	                if not line:
   680	                    continue
   681	                    
   682	                # 检测建议项（以数字开头或包含关键词）
   683	                if (line.startswith(('1.', '2.', '3.', '4.', '5.', '6.', '7.', '8.', '9.')) or
   684	                    any(keyword in line.lower() for keyword in ['建议', '推荐', '调整', '优化', '增加', '减少', '降低', '提高'])):
   685	                    
   686	                    if current_suggestion:
   687	                        suggestions.append(current_suggestion)
   688	                    
   689	                    current_suggestion = {
   690	                        'type': 'parameter_adjustment',
   691	                        'description': line,
   692	                        'priority': 'medium',
   693	                        'confidence': 0.7
   694	                    }
   695	                elif current_suggestion and line.startswith(('  ', '\t', '-', '*')):
   696	                    # 这是建议的详细说明
   697	                    current_suggestion['description'] += f" {line.strip()}"
   698	            
   699	            if current_suggestion:
   700	                suggestions.append(current_suggestion)
   701	                
   702	        except Exception as e:
   703	            print(f"[DEBUG] 解析文本建议失败: {str(e)}")
   704	        
   705	        return suggestions
   706	    
   707	    def _extract_json_suggestions(self, text: str) -> List[Dict[str, Any]]:
   708	        """从文本中提取JSON格式的建议"""
   709	        try:
   710	            import re
   711	            import json
   712	            
   713	            # 查找JSON代码块
   714	            json_pattern = r'```json\s*(\{.*?\})\s*```'
   715	            matches = re.findall(json_pattern, text, re.DOTALL)
   716	            
   717	            if not matches:
   718	                # 如果没有代码块标记，尝试直接查找JSON对象
   719	                json_pattern = r'\{[^{}]*"suggestions"[^{}]*\[.*?\][^{}]*\}'
   720	                matches = re.findall(json_pattern, text, re.DOTALL)
   721	            
   722	            for match in matches:
   723	                try:
   724	                    json_data = json.loads(match)
   725	                    if 'suggestions' in json_data and isinstance(json_data['suggestions'], list):
   726	                        print(f"[DEBUG] 成功解析JSON建议: {len(json_data['suggestions'])} 个建议")
   727	                        return json_data['suggestions']
   728	                except json.JSONDecodeError as e:
   729	                    print(f"[DEBUG] JSON解析失败: {str(e)}")
   730	                    continue
   731	            
   732	            return []
   733	            
   734	        except Exception as e:
   735	            print(f"[DEBUG] 提取JSON建议失败: {str(e)}")
   736	            return []
   737	    
   738	    def _generate_rule_based_suggestions(self, 
   739	                                       config: Dict[str, Any],
   740	                                       metrics: Dict[str, Any]) -> List[Dict[str, Any]]:
   741	        """基于规则生成建议"""
   742	        suggestions = []
   743	        
   744	        try:
   745	            train_loss = metrics.get('train_loss', 0)
   746	            val_loss = metrics.get('val_loss', 0)
   747	            train_acc = metrics.get('train_accuracy', 0)
   748	            val_acc = metrics.get('val_accuracy', 0)
   749	            epoch = metrics.get('epoch', 0)
   750	            
   751	            # 过拟合检测（使用可配置阈值，默认1.3）
   752	            overfit_ratio = self.current_session.original_config.get('overfitting_threshold', 1.3) if getattr(self, 'current_session', None) else 1.3
   753	            if val_loss > train_loss * overfit_ratio and epoch > 5:
   754	                suggestions.append({
   755	                    'parameter': 'dropout_rate',
   756	                    'current_value': config.get('dropout_rate', 0.0),
   757	                    'suggested_value': min(0.9, config.get('dropout_rate', 0.0) + 0.1),
   758	                    'reason': '检测到过拟合，建议增加Dropout率',
   759	                    'priority': 'high'
   760	                })
   761	                
   762	                suggestions.append({
   763	                    'parameter': 'weight_decay',
   764	                    'current_value': config.get('weight_decay', 0.0001),
   765	                    'suggested_value': config.get('weight_decay', 0.0001) * 1.5,
   766	                    'reason': '检测到过拟合，建议增加权重衰减',
   767	                    'priority': 'high'
   768	                })
   769	            
   770	            # 欠拟合检测
   771	            if train_acc < 0.6 and val_acc < 0.6 and epoch > 10:
   772	                suggestions.append({
   773	                    'parameter': 'learning_rate',
   774	                    'current_value': config.get('learning_rate', 0.001),
   775	                    'suggested_value': config.get('learning_rate', 0.001) * 1.5,
   776	                    'reason': '检测到欠拟合，建议增加学习率',
   777	                    'priority': 'high'
   778	                })
   779	            
   780	            # 收敛缓慢检测
   781	            if train_loss > 0.5 and epoch > 15:
   782	                suggestions.append({
   783	                    'parameter': 'learning_rate',
   784	                    'current_value': config.get('learning_rate', 0.001),
   785	                    'suggested_value': config.get('learning_rate', 0.001) * 0.5,
   786	                    'reason': '训练收敛缓慢，建议降低学习率',
   787	                    'priority': 'medium'
   788	                })
   789	            
   790	            return suggestions
   791	            
   792	        except Exception as e:
   793	            self.error_occurred.emit(f"生成规则建议失败: {str(e)}")
   794	            return []
   795	    
   796	    def _apply_optimization_suggestions(self, 
   797	                                      config: Dict[str, Any],
   798	                                      suggestions: List[Dict[str, Any]]) -> Dict[str, Any]:
   799	        """应用优化建议到配置"""
   800	        try:
   801	            optimized_config = copy.deepcopy(config)
   802	            
   803	            for suggestion in suggestions:
   804	                param_name = suggestion.get('parameter')
   805	                suggested_value = suggestion.get('suggested_value')
   806	                
   807	                if param_name in optimized_config and suggested_value is not None:
   808	                    # 应用约束
   809	                    constrained_value = self._apply_parameter_constraints(param_name, suggested_value)
   810	                    optimized_config[param_name] = constrained_value
   811	            
   812	            return optimized_config
   813	            
   814	        except Exception as e:
   815	            self.error_occurred.emit(f"应用优化建议失败: {str(e)}")
   816	            return config
   817	    
   818	    def _apply_parameter_constraints(self, param_name: str, value: Any) -> Any:
   819	        """应用参数约束"""
   820	        if param_name not in self.parameter_constraints:
   821	            return value
   822	        
   823	        constraints = self.parameter_constraints[param_name]
   824	        
   825	        # 应用范围约束
   826	        if 'min' in constraints:
   827	            value = max(value, constraints['min'])
   828	        if 'max' in constraints:
   829	            value = min(value, constraints['max'])
   830	        
   831	        # 应用步长约束
   832	        if 'step' in constraints and isinstance(value, (int, float)):
   833	            step = constraints['step']
   834	            value = round(value / step) * step
   835	        
   836	        return value
   837	    
   838	    def _validate_config(self, config: Dict[str, Any]) -> Dict[str, Any]:
   839	        """验证配置有效性"""
   840	        try:
   841	            validated_config = copy.deepcopy(config)
   842	            
   843	            # 验证必需参数
   844	            required_params = ['model_name', 'batch_size', 'learning_rate', 'num_epochs']
   845	            for param in required_params:
   846	                if param not in validated_config:
   847	                    self.error_occurred.emit(f"缺少必需参数: {param}")
   848	                    return config
   849	            
   850	            # 验证参数类型和范围
   851	            for param_name, value in validated_config.items():
   852	                if param_name in self.parameter_constraints:
   853	                    validated_config[param_name] = self._apply_parameter_constraints(param_name, value)
   854	            
   855	            return validated_config
   856	            
   857	        except Exception as e:
   858	            self.error_occurred.emit(f"验证配置失败: {str(e)}")
   859	            return config
   860	    
   861	    def _record_config_adjustment(self, 
   862	                                original_config: Dict[str, Any],
   863	                                adjusted_config: Dict[str, Any],
   864	                                training_metrics: Dict[str, Any],
   865	                                analysis_result: Dict[str, Any],
   866	                                training_round_id: str = None):
   867	        """记录配置调整"""
   868	        try:
   869	            # 训练轮次ID唯一性验证 - 最强的去重机制
   870	            if training_round_id:
   871	                with self._adjustment_lock:
   872	                    # 检查是否已经为此轮次ID生成过报告
   873	                    if hasattr(self, '_processed_round_ids'):
   874	                        if training_round_id in self._processed_round_ids:
   875	                            print(f"[DEBUG] 训练轮次ID已处理过，跳过记录 | round_id={training_round_id}")
   876	                            return
   877	                    else:
   878	                        self._processed_round_ids = set()
   879	                    
   880	                    # 标记此轮次ID为已处理
   881	                    self._processed_round_ids.add(training_round_id)
   882	                    print(f"[DEBUG] 标记训练轮次ID为已处理 | round_id={training_round_id}")
   883	            
   884	            # 备用去重机制：基于内容签名的去重（防止没有round_id的情况）
   885	            signature_source = {
   886	                'round_id': training_round_id,
   887	                'orig': original_config,
   888	                'adj': adjusted_config,
   889	                'metrics_epoch': training_metrics.get('epoch'),
   890	            }
   891	            signature_str = json.dumps(signature_source, ensure_ascii=False, sort_keys=True)
   892	            import hashlib, time as _t
   893	            signature = hashlib.md5(signature_str.encode('utf-8')).hexdigest()
   894	            now = _t.time()
   895	            with self._adjustment_lock:
   896	                if self._last_adjustment_signature == signature and (now - self._last_adjustment_time) < 2.0:
   897	                    print(f"[DEBUG] 跳过重复调整记录 | signature={signature[:8]} | round_id={training_round_id}")
   898	                    return
   899	                self._last_adjustment_signature = signature
   900	                self._last_adjustment_time = now
   901	
   902	            # 计算变更
   903	            changes = {}
   904	            for key, value in adjusted_config.items():
   905	                if key in original_config and original_config[key] != value:
   906	                    changes[key] = {
   907	                        'from': original_config[key],
   908	                        'to': value
   909	                    }
   910	            
   911	            if not changes:
   912	                return  # 没有变更，不记录
   913	            print(f"[DEBUG] 记录配置调整 | epoch={training_metrics.get('epoch')} | changes_keys={list(changes.keys())}")
   914	            
   915	            # 生成参数解释
   916	            parameter_explanations = []
   917	            try:
   918	                if self.report_generator and hasattr(self.report_generator, 'explanation_engine'):
   919	                    parameter_explanations = self.report_generator.explanation_engine.generate_parameter_explanations(
   920	                        original_config, adjusted_config, training_metrics, analysis_result
   921	                    )
   922	            except Exception as e:
   923	                print(f"[WARNING] 生成参数解释失败: {str(e)}")
   924	            
   925	            # 创建调整记录
   926	            adjustment = ConfigAdjustment(
   927	                adjustment_id=f"adj_{int(time.time())}",
   928	                timestamp=time.time(),
   929	                original_config=copy.deepcopy(original_config),
   930	                adjusted_config=copy.deepcopy(adjusted_config),
   931	                changes=changes,
   932	                reason=analysis_result.get('reason', '智能优化建议'),
   933	                training_metrics=copy.deepcopy(training_metrics),
   934	                llm_analysis=copy.deepcopy(analysis_result),
   935	                status='pending',
   936	                parameter_explanations=parameter_explanations
   937	            )
   938	            
   939	            # 添加到历史记录
   940	            self.adjustment_history.append(adjustment)
   941	            if self.current_session:
   942	                self.current_session.adjustments.append(adjustment)
   943	            
   944	            # 生成参数微调报告
   945	            if self.report_generator:
   946	                try:
   947	                    report_path = self.report_generator.generate_report(
   948	                        original_config=adjustment.original_config,
   949	                        adjusted_config=adjustment.adjusted_config,
   950	                        changes=adjustment.changes,
   951	                        llm_analysis=adjustment.llm_analysis,
   952	                        training_metrics=adjustment.training_metrics,
   953	                        reason=adjustment.reason,
   954	                        session_id=self.current_session.session_id if self.current_session else "",
   955	                        adjustment_id=adjustment.adjustment_id
   956	                    )
   957	                    
   958	                    if report_path:
   959	                        print(f"[INFO] 参数微调报告已生成: {report_path}")
   960	                        self.status_updated.emit(f"📄 参数微调报告已生成: {os.path.basename(report_path)}")
   961	                    else:
   962	                        print(f"[WARNING] 参数微调报告生成失败")
   963	                        
   964	                except Exception as e:
   965	                    print(f"[ERROR] 生成参数微调报告时发生错误: {str(e)}")
   966	                    self.error_occurred.emit(f"生成参数微调报告失败: {str(e)}")
   967	            
   968	            # 发射信号
   969	            self.adjustment_recorded.emit(asdict(adjustment))
   970	            
   971	        except Exception as e:
   972	            self.error_occurred.emit(f"记录配置调整失败: {str(e)}")
   973	    
   974	    def apply_config_to_training_system(self, 
