   464	func (executor *Executor) uploadArtifacts(ctx context.Context, jobID, experimentDirectory string, spec runtimeSpec, emit EmitFunc) error {
   465		if executor.backend == "native_mps" {
   466			command := []string{
   467				filepath.Join(executor.runtimeRoot, "bin", "python"),
   468				filepath.Join(executor.runtimeRoot, "llmweb", "upload_artifacts.py"),
   469				"--source", experimentDirectory,
   470				"--destination", spec.S3URI,
   471				"--formats", strings.Join(spec.Formats, ","),
   472				"--checkpoint", spec.Checkpoint,
   473			}
   474			if spec.S3Endpoint != "" {
   475				command = append(command, "--endpoint", spec.S3Endpoint)
   476			}
   477			emit("progress", "正在把模型产物保存到你的对象存储", map[string]any{"percent": 96})
   478			return executor.runNative(ctx, command, emit)
   479		}
   480		container := containerName(jobID) + "-upload"
   481		args := []string{
   482			"run", "--name", container,
   483			"--security-opt=no-new-privileges", "--cap-drop=ALL",
   484			"-v", experimentDirectory + ":/workspace/output:ro",
   485		}
   486		for _, variable := range []string{"AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_DEFAULT_REGION"} {
   487			if os.Getenv(variable) != "" {
   488				args = append(args, "-e", variable)
   489			}
   490		}
   491		args = append(args, approvedRuntimeImage,
   492			"python", "/opt/llmweb/upload_artifacts.py",
   493			"--source", "/workspace/output",
   494			"--destination", spec.S3URI,
   495			"--formats", strings.Join(spec.Formats, ","),
   496			"--checkpoint", spec.Checkpoint,
   497		)
   498		if spec.S3Endpoint != "" {
   499			args = append(args, "--endpoint", spec.S3Endpoint)
   500		}
   501		emit("progress", "正在把模型产物保存到你的对象存储", map[string]any{"percent": 96})
   502		if err := runDocker(ctx, container, args, emit); err != nil {
   503			if status, exists := dockerStatus(container); exists && status != "running" {
   504				_ = exec.Command("docker", "rm", container).Run()
   505			}
   506			return err
   507		}
   508		_ = exec.Command("docker", "rm", container).Run()
   509		return nil
   510	}
