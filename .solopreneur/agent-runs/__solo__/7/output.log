   512	func collectCheckpoints(adapterDirectory string) ([]map[string]any, error) {
   513		entries, err := os.ReadDir(adapterDirectory)
   514		if err != nil {
   515			return nil, fmt.Errorf("读取训练产生的模型版本: %w", err)
   516		}
   517		validationLoss := map[int]float64{}
   518		bestReference := "adapter"
   519		statePayload, stateErr := os.ReadFile(filepath.Join(adapterDirectory, "trainer_state.json"))
   520		if stateErr == nil {
   521			var state struct {
   522				BestModelCheckpoint string `json:"best_model_checkpoint"`
   523				LogHistory          []struct {
   524					Step     int      `json:"step"`
   525					EvalLoss *float64 `json:"eval_loss"`
   526				} `json:"log_history"`
   527			}
   528			if json.Unmarshal(statePayload, &state) == nil {
   529				if marker := "checkpoint-"; strings.Contains(state.BestModelCheckpoint, marker) {
   530					bestReference = "adapter/" + state.BestModelCheckpoint[strings.LastIndex(state.BestModelCheckpoint, marker):]
   531				}
   532				for _, item := range state.LogHistory {
   533					if item.EvalLoss != nil {
   534						validationLoss[item.Step] = *item.EvalLoss
   535					}
   536				}
   537			}
   538		}
   539		checkpoints := []map[string]any{{"reference": "adapter", "label": "训练完成结果", "recommended": bestReference == "adapter"}}
   540		for _, entry := range entries {
   541			if !entry.IsDir() || !strings.HasPrefix(entry.Name(), "checkpoint-") {
   542				continue
   543			}
   544			step, err := strconv.Atoi(strings.TrimPrefix(entry.Name(), "checkpoint-"))
   545			if err != nil {
   546				continue
   547			}
   548			reference := "adapter/" + entry.Name()
   549			item := map[string]any{"reference": reference, "label": fmt.Sprintf("训练进度 %d", step), "recommended": reference == bestReference, "step": step}
   550			if loss, exists := validationLoss[step]; exists {
   551				item["validation_loss"] = loss
   552			}
   553			checkpoints = append(checkpoints, item)
   554		}
   555		sort.SliceStable(checkpoints[1:], func(left, right int) bool {
   556			return checkpoints[left+1]["step"].(int) < checkpoints[right+1]["step"].(int)
   557		})
   558		return checkpoints, nil
   559	}
