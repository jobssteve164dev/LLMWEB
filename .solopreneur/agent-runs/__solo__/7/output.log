     1	"""
     2	智能训练状态管理器
     3	
     4	用于区分智能训练的重启过程和真正的训练停止，
     5	避免在微调参数时显示误导性的"训练已停止"弹窗。
     6	"""
     7	
     8	from enum import Enum
     9	from typing import Optional, Dict, Any
    10	from PyQt5.QtCore import QObject, pyqtSignal
    11	
    12	
    13	class TrainingState(Enum):
    14	    """训练状态枚举"""
    15	    IDLE = "idle"                    # 空闲状态
    16	    RUNNING = "running"              # 正常训练中
    17	    INTELLIGENT_RESTARTING = "intelligent_restarting"  # 智能训练重启中
    18	    STOPPED = "stopped"              # 真正停止
    19	    COMPLETED = "completed"          # 训练完成
    20	    ERROR = "error"                  # 训练错误
    21	
    22	
    23	class IntelligentTrainingStateManager(QObject):
    24	    """智能训练状态管理器"""
    25	    
    26	    # 信号定义
    27	    state_changed = pyqtSignal(TrainingState, str)  # 状态改变信号
    28	    intelligent_restart_started = pyqtSignal(dict)  # 智能重启开始信号
    29	    intelligent_restart_completed = pyqtSignal(dict)  # 智能重启完成信号
    30	    
    31	    def __init__(self, parent=None):
    32	        super().__init__(parent)
    33	        self.current_state = TrainingState.IDLE
    34	        self.restart_context: Optional[Dict[str, Any]] = None
    35	        
    36	    def set_state(self, new_state: TrainingState, message: str = ""):
    37	        """设置训练状态"""
    38	        if self.current_state != new_state:
    39	            old_state = self.current_state
    40	            self.current_state = new_state
    41	            
    42	            # 发射状态改变信号
    43	            self.state_changed.emit(new_state, message)
    44	            
    45	            # 特殊处理智能重启状态
    46	            if new_state == TrainingState.INTELLIGENT_RESTARTING:
    47	                self.intelligent_restart_started.emit(self.restart_context or {})
    48	            elif old_state == TrainingState.INTELLIGENT_RESTARTING and new_state == TrainingState.RUNNING:
    49	                self.intelligent_restart_completed.emit(self.restart_context or {})
    50	    
    51	    def start_intelligent_restart(self, context: Dict[str, Any]):
    52	        """开始智能重启过程"""
    53	        self.restart_context = context
    54	        self.set_state(TrainingState.INTELLIGENT_RESTARTING, "智能训练正在重启...")
    55	    
    56	    def complete_intelligent_restart(self):
    57	        """完成智能重启过程"""
    58	        self.set_state(TrainingState.RUNNING, "智能训练已重启")
    59	        self.restart_context = None
    60	    
    61	    def start_training(self):
    62	        """开始训练"""
    63	        self.set_state(TrainingState.RUNNING, "训练已开始")
    64	    
    65	    def stop_training(self):
    66	        """停止训练"""
    67	        self.set_state(TrainingState.STOPPED, "训练已停止")
    68	    
    69	    def complete_training(self):
    70	        """完成训练"""
    71	        self.set_state(TrainingState.COMPLETED, "训练已完成")
    72	    
    73	    def set_error(self, error_message: str):
    74	        """设置错误状态"""
    75	        self.set_state(TrainingState.ERROR, f"训练错误: {error_message}")
    76	    
    77	    def is_intelligent_restarting(self) -> bool:
    78	        """检查是否正在智能重启"""
    79	        return self.current_state == TrainingState.INTELLIGENT_RESTARTING
    80	    
    81	    def is_training_active(self) -> bool:
    82	        """检查训练是否活跃（运行中或重启中）"""
    83	        return self.current_state in [TrainingState.RUNNING, TrainingState.INTELLIGENT_RESTARTING]
    84	    
    85	    def get_current_state(self) -> TrainingState:
    86	        """获取当前状态"""
    87	        return self.current_state
    88	    
    89	    def get_state_message(self) -> str:
    90	        """获取状态消息"""
    91	        state_messages = {
    92	            TrainingState.IDLE: "训练空闲",
    93	            TrainingState.RUNNING: "训练中...",
    94	            TrainingState.INTELLIGENT_RESTARTING: "智能训练重启中...",
    95	            TrainingState.STOPPED: "训练已停止",
    96	            TrainingState.COMPLETED: "训练完成",
    97	            TrainingState.ERROR: "训练错误"
    98	        }
    99	        return state_messages.get(self.current_state, "未知状态")
     1	"""
     2	实时训练指标采集器 - 非侵入式数据采集
     3	
     4	主要功能：
     5	- 监听TensorBoard数据流，复制一份到本地文件
     6	- 为AI分析提供实时训练数据
     7	- 支持多种训练框架（分类、检测）
     8	- 自动清理历史数据，保持文件大小合理
     9	"""
    10	
    11	import os
    12	import json
    13	import time
    14	import threading
    15	from typing import Dict, Any, List, Optional
    16	from collections import deque
    17	from PyQt5.QtCore import QObject, pyqtSignal
    18	import torch
    19	from torch.utils.tensorboard.writer import SummaryWriter
    20	
    21	
    22	class RealTimeMetricsCollector(QObject):
    23	    """实时训练指标采集器"""
    24	    
    25	    # 信号定义
    26	    metrics_updated = pyqtSignal(dict)  # 新指标数据可用
    27	    analysis_data_ready = pyqtSignal(str)  # 分析数据文件就绪
    28	    
    29	    def __init__(self, max_history=100):
    30	        super().__init__()
    31	        self.max_history = max_history
    32	        self.metrics_buffer = deque(maxlen=max_history)
    33	        self.current_training_session = None
    34	        self.data_file_path = None
    35	        self.lock = threading.Lock()
    36	        
    37	        # 创建数据存储目录
    38	        self.data_dir = "logs/real_time_metrics"
    39	        os.makedirs(self.data_dir, exist_ok=True)
    40	        
    41	    def start_collection(self, training_session_id: str = None):
    42	        """开始数据采集"""
    43	        if training_session_id is None:
    44	            training_session_id = f"training_{int(time.time())}"
    45	            
    46	        self.current_training_session = training_session_id
    47	        self.data_file_path = os.path.join(
    48	            self.data_dir, 
    49	            f"{training_session_id}_metrics.json"
    50	        )
    51	        
    52	        # 初始化数据文件
    53	        initial_data = {
    54	            "session_id": training_session_id,
    55	            "start_time": time.time(),
    56	            "metrics_history": [],
    57	            "current_metrics": {},
    58	            "training_status": "started"
    59	        }
    60	        
    61	        with open(self.data_file_path, 'w', encoding='utf-8') as f:
    62	            json.dump(initial_data, f, indent=2, ensure_ascii=False)
