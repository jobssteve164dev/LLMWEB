{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmweb.local/contracts/dataset-inspection-job.schema.json",
  "title": "LLMWEB Dataset Inspection Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "source_type", "source_ref", "format", "mapping", "split", "preview_allowed"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "source_type": { "enum": ["local", "huggingface", "modelscope", "s3"] },
    "source_ref": { "type": "string", "minLength": 1 },
    "format": { "enum": ["json", "jsonl", "csv"] },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "input", "output"],
      "properties": {
        "instruction": { "type": "string", "minLength": 1 },
        "input": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": { "type": "integer", "minimum": 1, "maximum": 98 },
        "validation": { "type": "integer", "minimum": 1, "maximum": 98 },
        "test": { "type": "integer", "minimum": 1, "maximum": 98 }
      }
    },
    "preview_allowed": { "type": "boolean" }
  }
}
