{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmweb.local/contracts/training-job.schema.json",
  "title": "LLMWEB Model Pipeline Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "project_id",
    "experiment_id",
    "dataset_id",
    "task",
    "model",
    "training",
    "environment",
    "runtime",
    "output"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "workspace_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "task": { "enum": ["baseline", "train", "evaluate", "export"] },
    "selected_checkpoint": { "type": "string", "minLength": 1 },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id", "revision", "template"],
      "properties": {
        "source": { "enum": ["huggingface", "github"] },
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "template": { "enum": ["qwen", "llama3", "mistral", "gemma", "default", "character"] }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "epochs", "learning_rate", "max_length", "batch_size", "gradient_accumulation"],
      "properties": {
        "method": { "enum": ["lora", "qlora", "starter"] },
        "epochs": { "type": "number", "exclusiveMinimum": 0 },
        "learning_rate": { "type": "number", "exclusiveMinimum": 0 },
        "max_length": { "type": "integer", "minimum": 128 },
        "batch_size": { "type": "integer", "minimum": 1 },
        "gradient_accumulation": { "type": "integer", "minimum": 1 },
        "iterations": { "type": "integer", "minimum": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "backend"],
      "properties": {
        "version": { "type": "string", "anyOf": [{ "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, { "const": "legacy-0.1.0" }] },
        "backend": { "enum": ["linux-amd64-cpu", "linux-amd64-cuda", "darwin-arm64-mps"] }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "image"],
      "properties": {
        "engine": { "enum": ["llamafactory", "nanogpt"] },
        "image": { "pattern": "^llmweb/runtime(?:-cpu)?:[A-Za-z0-9._-]+$" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats"],
      "properties": {
        "preview_allowed": { "type": "boolean" },
        "destination": { "enum": ["local", "user_s3"] },
        "s3_uri": { "type": ["string", "null"] },
        "s3_endpoint": { "type": ["string", "null"] },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["adapter", "huggingface", "gguf"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "task": { "enum": ["evaluate", "export"] } } },
      "then": { "required": ["selected_checkpoint"] }
    }
  ]
}
