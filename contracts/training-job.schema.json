{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmweb.local/contracts/training-job.schema.json",
  "title": "LLMWEB Training Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "workspace_id",
    "project_id",
    "task",
    "model",
    "dataset",
    "training",
    "runtime",
    "output"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "job_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "task": { "const": "sft" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id", "revision"],
      "properties": {
        "source": { "enum": ["huggingface", "modelscope", "local"] },
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_id", "location"],
      "properties": {
        "version_id": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "epochs", "learning_rate", "max_length"],
      "properties": {
        "method": { "enum": ["lora", "qlora"] },
        "epochs": { "type": "number", "exclusiveMinimum": 0 },
        "learning_rate": { "type": "number", "exclusiveMinimum": 0 },
        "max_length": { "type": "integer", "minimum": 128 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "image"],
      "properties": {
        "engine": { "const": "llamafactory" },
        "image": { "type": "string", "minLength": 1 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "formats"],
      "properties": {
        "destination": { "enum": ["local", "user_s3"] },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["adapter", "merged", "huggingface", "gguf"] }
        }
      }
    }
  }
}
