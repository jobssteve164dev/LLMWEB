{
  "name": "llmweb",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev:web": "pnpm --filter @llmweb/web dev",
    "build:web": "pnpm --filter @llmweb/web build",
    "lint:web": "pnpm --filter @llmweb/web lint",
    "typecheck:web": "pnpm --filter @llmweb/web typecheck",
    "check:plan-single-track": "node scripts/check-plan-single-track.mjs",
    "check:training-environment": "bash -n scripts/install-runner.sh scripts/build-training-environment-release.sh scripts/verify-training-environment-release.sh && node scripts/check-training-environment.mjs && node scripts/check-training-environment-release-verifier.mjs",
    "check": "pnpm check:plan-single-track && pnpm check:training-environment && pnpm lint:web && pnpm typecheck:web && pnpm build:web"
  }
}
