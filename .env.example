# Runner 能够访问的训练面板公网地址
LLMWEB_PUBLIC_URL=https://llmweb.example.com

# GPU 主机执行的一键安装脚本地址
LLMWEB_RUNNER_INSTALLER_URL=https://raw.githubusercontent.com/jobssteve164dev/LLMWEB/main/scripts/install-runner.sh

# Web 与控制面之间的内部凭证，请在部署时更换为随机长字符串
LLMWEB_WEB_TOKEN=change-this-token

# LLMWEB 自己的会话签名密钥，请使用独立随机长字符串
LLMWEB_SESSION_SECRET=change-this-session-secret

# SZLKPassport Headless 登录注册（仅服务端使用）
SZLK_PASSPORT_URL=https://passport.szlk.ai
SZLK_PASSPORT_SECRET=replace-with-passport-issued-secret
PASSPORT_PRODUCT=llmweb
APP_BASE_URL=https://llmweb.example.com

# 可选：法律正文服务地址；默认使用正式 SZLKlaws 服务
SZLKLAWS_BASE_URL=https://laws.szlk.ai

# 可选：升级前单工作区数据的明确归属人；未配置时旧数据保留但不会暴露给新账号
LLMWEB_LEGACY_OWNER_EMAIL=

# PostgreSQL 密码，请在部署时更换
LLMWEB_POSTGRES_PASSWORD=change-this-password
