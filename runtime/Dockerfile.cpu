ARG PYTHON_BASE_IMAGE=python:3.13-slim-trixie@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a
FROM ${PYTHON_BASE_IMAGE}

ARG NANOGPT_REF=3adf61e154c3fe3fca428ad6bc3818b27a3b8291
ARG TORCH_WHEEL_SHA256=8d316e5bf121f1eab1147e49ad0511a9d92e4c45cc357d1ab0bee440da71a095
ARG STARTER_DATASET_SHA256=86c4e6aa9db7c042ec79f339dcb96d42b0075e16b8fc2e86bf0ca57e2dc565ed

LABEL ai.szlk.llmweb.nanogpt-ref="$NANOGPT_REF"

ENV PIP_ROOT_USER_ACTION=ignore \
    PYTHONUNBUFFERED=1

COPY runtime/torch-2.10.0+cpu-cp313-cp313-manylinux_2_28_x86_64.whl /tmp/torch-2.10.0+cpu-cp313-cp313-manylinux_2_28_x86_64.whl
COPY runtime/nanogpt-3adf61e154c3fe3fca428ad6bc3818b27a3b8291/ /opt/nanogpt/
COPY runtime/python-wheels/ /tmp/wheels/
COPY runtime/python-wheels.sha256 /tmp/wheels.sha256
COPY runtime/tiny-shakespeare-6f9487a6fe5b420b7ca9afb0d7c078e37c1d1b4e.txt /opt/llmweb/starter/tiny-shakespeare.txt

RUN printf '%s  %s\n' "$TORCH_WHEEL_SHA256" /tmp/torch-2.10.0+cpu-cp313-cp313-manylinux_2_28_x86_64.whl | sha256sum -c - \
    && printf '%s  %s\n' "$STARTER_DATASET_SHA256" /opt/llmweb/starter/tiny-shakespeare.txt | sha256sum -c - \
    && cd /tmp/wheels \
    && sha256sum -c /tmp/wheels.sha256 \
    && pip install --no-cache-dir --no-index --find-links /tmp/wheels /tmp/torch-2.10.0+cpu-cp313-cp313-manylinux_2_28_x86_64.whl \
    && pip uninstall --yes pip setuptools wheel \
    && rm -f /tmp/torch-2.10.0+cpu-cp313-cp313-manylinux_2_28_x86_64.whl /tmp/wheels/*.whl

COPY runtime/cpu_starter.py /opt/llmweb/cpu_starter.py

ENV PYTHONPATH=/opt/nanogpt
WORKDIR /workspace
