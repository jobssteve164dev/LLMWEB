ARG PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.11-slim-bookworm
FROM ${PYTHON_BASE_IMAGE}

ARG NANOGPT_REF=3adf61e154c3fe3fca428ad6bc3818b27a3b8291
ARG TORCH_WHEEL_SHA256=cb06175284673a581dd91fb1965662ae4ecaba6e5c357aa0ea7bb8b84b6b7eeb

LABEL ai.szlk.llmweb.nanogpt-ref="$NANOGPT_REF"

ENV PIP_ROOT_USER_ACTION=ignore \
    PYTHONUNBUFFERED=1

COPY runtime/torch-2.8.0+cpu-cp311-cp311-manylinux_2_28_x86_64.whl /tmp/torch.whl
COPY runtime/nanogpt-3adf61e154c3fe3fca428ad6bc3818b27a3b8291/ /opt/nanogpt/

RUN printf '%s  %s\n' "$TORCH_WHEEL_SHA256" /tmp/torch.whl | sha256sum -c - \
    && pip install --no-cache-dir --index-url https://mirrors.aliyun.com/pypi/simple/ /tmp/torch.whl \
    && rm -f /tmp/torch.whl

COPY runtime/cpu_starter.py /opt/llmweb/cpu_starter.py

ENV PYTHONPATH=/opt/nanogpt
WORKDIR /workspace
