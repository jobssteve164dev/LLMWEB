ARG PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.11-slim-bookworm
FROM ${PYTHON_BASE_IMAGE}

ARG NANOGPT_REF=3adf61e154c3fe3fca428ad6bc3818b27a3b8291
ARG NANOGPT_SOURCE_URL=https://github.com/karpathy/nanoGPT/archive/3adf61e154c3fe3fca428ad6bc3818b27a3b8291.tar.gz

LABEL ai.szlk.llmweb.nanogpt-ref="$NANOGPT_REF"

ENV PIP_ROOT_USER_ACTION=ignore \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.8.0 \
    && mkdir -p /opt/nanogpt \
    && curl -fsSL "$NANOGPT_SOURCE_URL" -o /opt/nanogpt.tar.gz \
    && tar -xzf /opt/nanogpt.tar.gz --strip-components=1 -C /opt/nanogpt \
    && apt-get clean

COPY runtime/cpu_starter.py /opt/llmweb/cpu_starter.py

ENV PYTHONPATH=/opt/nanogpt
WORKDIR /workspace
